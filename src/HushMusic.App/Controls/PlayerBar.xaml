<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:np="using:HushMusic.App.Controls.NowPlaying"
    xmlns:radio="using:HushMusic.App.Controls.Radio">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--
                Thin Apple-style sliders: 3 px rail, accent fill that follows the accent, knob only on hover.
                Aliases to theme tokens live in theme dictionaries: a plain StaticResource alias would keep one theme's value.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="SliderTrackFill" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillDisabled" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="TextPrimaryBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="TextPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="SliderTrackFill" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillDisabled" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="TextPrimaryBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="TextPrimaryBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
            <x:Double x:Key="SliderHorizontalHeight">16</x:Double>
            <x:Double x:Key="SliderPreContentMargin">6.5</x:Double>
            <x:Double x:Key="SliderPostContentMargin">6.5</x:Double>
            <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">11</x:Double>
            <x:Double x:Key="SliderInnerThumbHeight">11</x:Double>
            <CornerRadius x:Key="SliderTrackCornerRadius">1.5</CornerRadius>
            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush" />
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />

            <!--  The artwork opens Now Playing: no chrome, dims a little when pressed.  -->
            <Style x:Key="PlayerArtButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                AutomationProperties.AccessibilityView="Raw"
                                Background="{TemplateBinding Background}"
                                Content="{TemplateBinding Content}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Opacity" Value="0.88" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Opacity" Value="0.72" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Floating glass bar; the shell sets the margins. Tracks dragged from pages can be dropped here (added to the queue).  -->
    <Grid
        x:Name="Surface"
        Height="{StaticResource PlayerBarHeight}"
        AllowDrop="True"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <!--  Narrow windows drop the volume slider (mute stays; Now Playing has a full volume slider).  -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1260" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border
            Padding="14,0,14,0"
            Background="{ThemeResource GlassBrush}"
            BorderBrush="{ThemeResource SeparatorBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            Shadow="{StaticResource ShellShadow}"
            Translation="0,0,24">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="1.4*" MaxWidth="560" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!--  Now playing: artwork and title open Now Playing, artists link to their page  -->
                <Grid VerticalAlignment="Center" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        AutomationProperties.AutomationId="PlayerBarArtwork"
                        AutomationProperties.Name="Open Now Playing"
                        Command="{x:Bind NowPlaying.ToggleCommand}"
                        IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                        Style="{StaticResource PlayerArtButtonStyle}"
                        ToolTipService.ToolTip="Now Playing">
                        <Grid
                            Width="{StaticResource PlayerArtSize}"
                            Height="{StaticResource PlayerArtSize}"
                            Background="{ThemeResource Surface2Brush}"
                            CornerRadius="{StaticResource RadiusSmall}">
                            <FontIcon
                                FontSize="18"
                                Foreground="{ThemeResource TextTertiaryBrush}"
                                Glyph="&#xEC4F;" />
                            <Image
                                helpers:ImageLoader.DecodeWidth="48"
                                helpers:ImageLoader.Url="{x:Bind ViewModel.CoverUrl, Mode=OneWay}"
                                AutomationProperties.AccessibilityView="Raw"
                                Stretch="UniformToFill"
                                Visibility="{x:Bind ViewModel.IsNotLive, Mode=OneWay}" />
                            <radio:StationArt
                                LogoUrl="{x:Bind ViewModel.LiveArtUrl, Mode=OneWay}"
                                StationName="{x:Bind ViewModel.StationName, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}" />
                            <Border
                                BorderBrush="{ThemeResource SeparatorBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}" />
                        </Grid>
                    </Button>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1"
                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasTrack), Mode=OneWay}">
                        <!--  Live radio: "LIVE" eyebrow over the song title.  -->
                        <radio:LiveBadge
                            Margin="0,0,0,3"
                            AutomationProperties.AutomationId="PlayerBarLive"
                            Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}" />
                        <Button
                            AutomationProperties.AutomationId="PlayerBarTitle"
                            AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                            Command="{x:Bind NowPlaying.ToggleCommand}"
                            Style="{StaticResource ShellTitleLinkButtonStyle}"
                            ToolTipService.ToolTip="Now Playing">
                            <TextBlock Style="{StaticResource HeadlineStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                        </Button>
                        <np:CreditsText Credits="{x:Bind NowPlaying.ArtistCredits, Mode=OneWay}" TextStyle="{StaticResource SubheadStyle}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1"
                        Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.HasTrack), Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Style="{StaticResource HeadlineStyle}"
                            Text="Not playing" />
                        <TextBlock
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            Style="{StaticResource FootnoteStyle}"
                            Text="Pick a song to start listening" />
                    </StackPanel>
                </Grid>

                <!--  Transport and progress  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="14">
                        <ToggleButton
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Shuffle"
                            Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                            Content="&#xE8B1;"
                            FontSize="14"
                            IsChecked="{x:Bind ViewModel.IsShuffleEnabled, Mode=OneWay}"
                            Style="{StaticResource IconToggleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ShuffleLabel, Mode=OneWay}" />
                        <Button
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Previous"
                            Command="{x:Bind ViewModel.PreviousCommand}"
                            Content="&#xF8AC;"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Previous (Ctrl+Left)" />
                        <Button
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="PlayerBarPlayPause"
                            AutomationProperties.Name="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.PlayPauseCommand}"
                            Style="{StaticResource PlayButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}">
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Text="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.IsLoading), Mode=OneWay}" />
                                <ProgressRing
                                    Width="18"
                                    Height="18"
                                    Foreground="{ThemeResource AppBackgroundBrush}"
                                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Next"
                            Command="{x:Bind ViewModel.NextCommand}"
                            Content="&#xF8AD;"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Next (Ctrl+Right)" />
                        <ToggleButton
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Repeat"
                            Command="{x:Bind ViewModel.CycleRepeatCommand}"
                            Content="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}"
                            FontSize="14"
                            IsChecked="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay}"
                            Style="{StaticResource IconToggleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.RepeatLabel, Mode=OneWay}" />
                    </StackPanel>

                    <!--  Live radio has no timeline: a quiet, static accent hairline where the seek bar was.  -->
                    <Grid Height="16" Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}">
                        <Rectangle
                            Height="2"
                            Margin="44,0,44,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource AccentBrush}"
                            Opacity="0.35"
                            RadiusX="1"
                            RadiusY="1" />
                    </Grid>
                    <Grid
                        Height="16"
                        ColumnSpacing="8"
                        Visibility="{x:Bind ViewModel.IsNotLive, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource PlayerTimeTextStyle}"
                            Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                            TextAlignment="Right" />
                        <Slider
                            x:Name="SeekSlider"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Seek"
                            IsEnabled="{x:Bind ViewModel.CanSeek, Mode=OneWay}"
                            LargeChange="15"
                            Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                            Minimum="0"
                            SmallChange="5"
                            StepFrequency="1"
                            ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                            Value="{x:Bind ViewModel.PositionSeconds, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource PlayerTimeTextStyle}"
                            Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                    </Grid>
                </StackPanel>

                <!--  Like, Now Playing tabs, sleep timer, mini player, volume  -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <ToggleButton
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Like"
                        Command="{x:Bind ViewModel.ToggleLikeCommand}"
                        Content="{x:Bind ViewModel.LikeGlyph, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.IsLiked, Mode=OneWay}"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.LikeLabel, Mode=OneWay}"
                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.CanRate), Mode=OneWay}" />
                    <ToggleButton
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="PlayerBarLyrics"
                        AutomationProperties.Name="Lyrics"
                        Command="{x:Bind NowPlaying.ToggleLyricsCommand}"
                        Content="&#xE8BD;"
                        IsChecked="{x:Bind NowPlaying.IsLyricsActive, Mode=OneWay}"
                        IsEnabled="{x:Bind NowPlaying.CanShowLyrics, Mode=OneWay}"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="Lyrics" />
                    <ToggleButton
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="PlayerBarQueue"
                        AutomationProperties.Name="Up next"
                        Command="{x:Bind NowPlaying.ToggleUpNextCommand}"
                        Content="&#xE8FD;"
                        IsChecked="{x:Bind NowPlaying.IsUpNextActive, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="Up next" />
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="PlayerBarSleepTimer"
                        AutomationProperties.HelpText="{x:Bind NowPlaying.SleepTimer.Label, Mode=OneWay}"
                        AutomationProperties.Name="Sleep timer"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind NowPlaying.SleepTimer.Label, Mode=OneWay}">
                        <Grid>
                            <FontIcon
                                FontSize="15"
                                Glyph="&#xE708;"
                                Visibility="{x:Bind helpers:Format.CollapsedIf(NowPlaying.SleepTimer.IsActive), Mode=OneWay}" />
                            <FontIcon
                                FontSize="15"
                                Foreground="{StaticResource AccentBrush}"
                                Glyph="&#xE708;"
                                Visibility="{x:Bind helpers:Format.VisibleIf(NowPlaying.SleepTimer.IsActive), Mode=OneWay}" />
                        </Grid>
                        <Button.Flyout>
                            <np:SleepTimerMenuFlyout Placement="TopEdgeAlignedRight" ViewModel="{x:Bind NowPlaying.SleepTimer}" />
                        </Button.Flyout>
                    </Button>
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="PlayerBarMiniPlayer"
                        AutomationProperties.Name="Mini player"
                        Command="{x:Bind NowPlaying.EnterMiniPlayerCommand}"
                        Content="&#xE92C;"
                        FontSize="15"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Mini player" />
                    <Button
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ViewModel.MuteLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleMuteCommand}"
                        Content="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}"
                        FontSize="14"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MuteLabel, Mode=OneWay}" />
                    <Slider
                        x:Name="VolumeSlider"
                        Width="88"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Volume"
                        LargeChange="10"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="2"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Shown while tracks are dragged over the bar.  -->
        <Border
            x:Name="DropHighlight"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="2"
            CornerRadius="{StaticResource RadiusLarge}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
