<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Settings.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    IsTabStop="False">

    <!--  Text on the left (wraps), the control on the right at its natural size, vertically centred.  -->
    <Grid Style="{StaticResource SettingsRowStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource SettingsRowLabelStyle}" Text="{x:Bind Title, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource SettingsRowDescriptionStyle}"
                Text="{x:Bind Description, Mode=OneWay}"
                Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(Description), Mode=OneWay}" />
        </StackPanel>

        <ContentPresenter
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="{x:Bind Action, Mode=OneWay}" />
    </Grid>
</UserControl>
