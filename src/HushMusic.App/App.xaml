<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="HushMusic.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <!--
        The Application theme stays Dark (it can't change while running). The theme the user picks (Dark / Light / follow
        Windows) is applied by ThemeService as RequestedTheme on the window content; popups get it explicitly.
        The Windows design (Settings > Design) puts Resources/Fluent over these dictionaries at startup (DesignSystems).
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Design system: tokens, type ramp, glass, stock-control remapping. -->
                <ResourceDictionary Source="ms-appx:///Resources/Theme.xaml" />
                <!-- Shared component styles built on the tokens. -->
                <ResourceDictionary Source="ms-appx:///Resources/Styles.xaml" />
                <!-- Shell: player bar, queue, dialogs. -->
                <ResourceDictionary Source="ms-appx:///Resources/ShellResources.xaml" />
                <!-- Pages: item templates, cards, track rows. -->
                <ResourceDictionary Source="ms-appx:///Resources/PageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
