<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.NowPlaying.HeardOnAirPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:vm="using:HushMusic.App.ViewModels.NowPlaying"
    IsTabStop="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/NowPlaying/NowPlayingResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Save songs to a playlist: per station, needs an account.  -->
        <Grid
            Margin="16,0,16,10"
            Padding="14,10,12,10"
            Background="{ThemeResource HoverFillBrush}"
            ColumnSpacing="12"
            CornerRadius="12"
            Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ViewModel.StationName), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Style="{StaticResource BodyStyle}" Text="Save songs to a playlist" />
                <TextBlock
                    AutomationProperties.AutomationId="HeardAutoSaveDescription"
                    Foreground="{ThemeResource TextTertiaryBrush}"
                    Style="{StaticResource FootnoteStyle}"
                    Text="{x:Bind ViewModel.AutoSaveDescription, Mode=OneWay}"
                    TextTrimming="None"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                AutomationProperties.AutomationId="HeardAutoSaveToggle"
                AutomationProperties.HelpText="{x:Bind ViewModel.AutoSaveDescription, Mode=OneWay}"
                AutomationProperties.Name="Save songs to a playlist"
                IsEnabled="{x:Bind ViewModel.CanAutoSave, Mode=OneWay}"
                IsOn="{x:Bind ViewModel.IsAutoSaveOn, Mode=TwoWay}" />
        </Grid>

        <TextBlock
            Grid.Row="1"
            Margin="20,6,16,8"
            Foreground="{ThemeResource TextTertiaryBrush}"
            Style="{StaticResource FootnoteStyle}"
            Text="{x:Bind ViewModel.Caption, Mode=OneWay}"
            Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.IsEmpty), Mode=OneWay}" />

        <!--  Newest first; a click finds the song on YouTube Music.  -->
        <ScrollViewer
            Grid.Row="2"
            AutomationProperties.AutomationId="NowPlayingHeard"
            AutomationProperties.Name="Heard on air"
            HorizontalScrollMode="Disabled"
            Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.IsEmpty), Mode=OneWay}">
            <ItemsControl
                Margin="8,0,8,16"
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeardSongViewModel">
                        <Button
                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                            Click="OnSongClick"
                            Style="{StaticResource NowPlayingRowButtonStyle}"
                            ToolTipService.ToolTip="Find on YouTube Music">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="40"
                                    Height="40"
                                    Background="{ThemeResource Surface2Brush}"
                                    CornerRadius="{StaticResource RadiusSmall}">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextTertiaryBrush}"
                                        Glyph="&#xEC4F;" />
                                    <Image
                                        helpers:ImageLoader.DecodeWidth="40"
                                        helpers:ImageLoader.Url="{x:Bind ArtworkUrl}"
                                        Stretch="UniformToFill" />
                                </Grid>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Bind Title}" />
                                    <TextBlock
                                        Style="{StaticResource FootnoteStyle}"
                                        Text="{x:Bind Artist}"
                                        Visibility="{x:Bind HasArtist}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <!--  Saved to the station's playlist.  -->
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextBrush}"
                                        Glyph="&#xE73E;"
                                        ToolTipService.ToolTip="Saved to the station's playlist"
                                        Visibility="{x:Bind IsSaved, Mode=OneWay}" />
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock
                                            Foreground="{ThemeResource TextTertiaryBrush}"
                                            Style="{StaticResource FootnoteStyle}"
                                            Text="{x:Bind TimeText}"
                                            Typography.NumeralAlignment="Tabular"
                                            Visibility="{x:Bind IsNotOnAir, Mode=OneWay}" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextBrush}"
                                            Style="{StaticResource FootnoteStyle}"
                                            Text="On air"
                                            Visibility="{x:Bind IsOnAir, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="32,0,32,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,6"
                FontSize="28"
                Foreground="{ThemeResource TextTertiaryBrush}"
                Glyph="&#xEC05;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource HeadlineStyle}"
                Text="Nothing heard yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubheadStyle}"
                Text="Songs show up here as the station plays them, if it shares their titles."
                TextAlignment="Center"
                TextTrimming="None"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
