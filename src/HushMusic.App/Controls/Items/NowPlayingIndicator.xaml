<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Items.NowPlayingIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsHitTestVisible="False"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <StackPanel
        Height="14"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="2">
        <Rectangle
            Width="3"
            x:Name="Bar1"
            Height="14"
            Fill="{x:Bind Foreground, Mode=OneWay}"
            RadiusX="1.5"
            RadiusY="1.5" />
        <Rectangle
            Width="3"
            x:Name="Bar2"
            Height="14"
            Fill="{x:Bind Foreground, Mode=OneWay}"
            RadiusX="1.5"
            RadiusY="1.5" />
        <Rectangle
            Width="3"
            x:Name="Bar3"
            Height="14"
            Fill="{x:Bind Foreground, Mode=OneWay}"
            RadiusX="1.5"
            RadiusY="1.5" />
    </StackPanel>
</UserControl>
