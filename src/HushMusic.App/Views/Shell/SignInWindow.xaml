<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HushMusic.App.Views.Shell.SignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    Title="Sign in to YouTube Music">

    <!--  RequestedTheme is set from IThemeService in code (the app's theme setting).  -->
    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Google's sign-in page. Only accounts.google.com is ever visible here.  -->
        <WebView2 x:Name="SignInView" />

        <!--  Covers the browser while starting, after landing on music.youtube.com, and on errors.  -->
        <Grid Background="{ThemeResource AppBackgroundBrush}" Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsOverlayVisible), Mode=OneWay}">
            <StackPanel
                MaxWidth="360"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsBusy), Mode=OneWay}" />
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="{ThemeResource WarningBrush}"
                    Glyph="&#xE7BA;"
                    Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.CanRetry), Mode=OneWay}" />
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Title2Style}"
                    Text="{x:Bind ViewModel.OverlayTitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="None"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubheadStyle}"
                    Text="{x:Bind ViewModel.OverlayMessage, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="None"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ViewModel.OverlayMessage), Mode=OneWay}" />
                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="Try again"
                    Style="{StaticResource PillButtonStyle}"
                    Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.CanRetry), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="20,12,16,12"
            Background="{ThemeResource Surface1Brush}"
            BorderBrush="{ThemeResource SeparatorBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Style="{StaticResource FootnoteStyle}"
                    Text="This window closes by itself once you're signed in."
                    TextTrimming="None"
                    TextWrapping="Wrap" />
                <Button
                    Margin="-6,0,0,0"
                    Command="{x:Bind ViewModel.UseCookieHeaderCommand}"
                    Content="Trouble signing in? Paste a cookie header instead"
                    Style="{StaticResource TextActionButtonStyle}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="Cancel"
                Style="{StaticResource PillSecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
