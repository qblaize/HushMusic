<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsTfm>net10.0-windows10.0.19041.0</WindowsTfm>
    <WindowsMinVersion>10.0.17763.0</WindowsMinVersion>
    <Company>HushMusic</Company>
    <Product>HushMusic</Product>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- The one app version: assemblies, Settings -> About, and the release package (build/release.ps1 reads it). -->
    <Version>0.3.2</Version>
  </PropertyGroup>
</Project>
