<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.NowPlaying.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:local="using:HushMusic.App.Controls.NowPlaying"
    xmlns:vm="using:HushMusic.App.ViewModels.Shell"
    IsTabStop="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/NowPlaying/NowPlayingResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ProgressRing
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextSecondaryBrush}"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />

        <!--  Error  -->
        <StackPanel
            Margin="32,0,32,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasError), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,6"
                FontSize="28"
                Foreground="{ThemeResource TextTertiaryBrush}"
                Glyph="&#xEA39;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource HeadlineStyle}"
                Text="Couldn't load the lyrics" />
            <TextBlock
                HorizontalAlignment="Center"
                MaxLines="3"
                Style="{StaticResource SubheadStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.RetryCommand}"
                Content="Try again"
                Style="{StaticResource PillSecondaryButtonStyle}" />
        </StackPanel>

        <!--  Empty  -->
        <StackPanel
            Margin="32,0,32,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ViewModel.Message), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,6"
                FontSize="28"
                Foreground="{ThemeResource TextTertiaryBrush}"
                Glyph="&#xE8BD;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource HeadlineStyle}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextTrimming="None"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Synced: the current line is bright and kept about a third of the way down.  -->
        <ScrollViewer
            x:Name="SyncedScroller"
            AutomationProperties.AutomationId="NowPlayingSyncedLyrics"
            AutomationProperties.Name="Lyrics"
            HorizontalScrollMode="Disabled"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsSynced), Mode=OneWay}">
            <StackPanel x:Name="SyncedContent" Padding="12,16,12,0">
                <ItemsControl
                    x:Name="LinesList"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LyricLineViewModel">
                            <local:LyricLineButton
                                Margin="0,0,0,4"
                                AutomationProperties.Name="{x:Bind Text}"
                                Click="OnLineClick"
                                IsCurrent="{x:Bind IsCurrent, Mode=OneWay}"
                                Style="{StaticResource LyricLineButtonStyle}">
                                <TextBlock Style="{StaticResource LyricLineTextStyle}" Text="{x:Bind Text}" />
                            </local:LyricLineButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="12,24,12,0"
                    Foreground="{ThemeResource TextTertiaryBrush}"
                    Style="{StaticResource FootnoteStyle}"
                    Text="{x:Bind ViewModel.Source, Mode=OneWay}"
                    TextTrimming="None"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ViewModel.Source), Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <!--  Unsynced: plain, selectable text.  -->
        <ScrollViewer
            x:Name="PlainScroller"
            Padding="24,12,24,32"
            AutomationProperties.AutomationId="NowPlayingPlainLyrics"
            HorizontalScrollMode="Disabled"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsPlain), Mode=OneWay}">
            <StackPanel Spacing="24">
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource LyricsPlainTextStyle}"
                    Text="{x:Bind ViewModel.Text, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextTertiaryBrush}"
                    Style="{StaticResource FootnoteStyle}"
                    Text="{x:Bind ViewModel.Source, Mode=OneWay}"
                    TextTrimming="None"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ViewModel.Source), Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
