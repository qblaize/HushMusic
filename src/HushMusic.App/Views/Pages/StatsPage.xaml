<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HushMusic.App.Views.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:items="using:HushMusic.App.Controls.Items"
    xmlns:radio="using:HushMusic.App.Controls.Radio"
    xmlns:vm="using:HushMusic.App.ViewModels.Pages">

    <Page.Resources>
        <!-- A headline number. -->
        <DataTemplate x:Key="TileTemplate" x:DataType="vm:StatsTile">
            <Border
                Padding="18,16"
                Background="{ThemeResource Surface1Brush}"
                CornerRadius="{StaticResource RadiusMedium}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource FootnoteStyle}" Text="{x:Bind Label}" />
                    <TextBlock
                        Style="{StaticResource Title2Style}"
                        Text="{x:Bind Value}"
                        Typography.NumeralAlignment="Tabular" />
                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{x:Bind Caption}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Top songs: rank, cover, title and artists, plays and time. -->
        <DataTemplate x:Key="SongRowTemplate" x:DataType="vm:StatsRankItem">
            <Button
                AutomationProperties.Name="{x:Bind AutomationName}"
                Click="OnRankItemClick"
                Style="{StaticResource RowButtonStyle}"
                ToolTipService.ToolTip="Play">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextTertiaryBrush}"
                        Style="{StaticResource SubheadStyle}"
                        Text="{x:Bind Rank}"
                        Typography.NumeralAlignment="Tabular" />
                    <Grid
                        Grid.Column="1"
                        Width="{StaticResource RowArtSize}"
                        Height="{StaticResource RowArtSize}"
                        Background="{ThemeResource Surface2Brush}"
                        CornerRadius="{StaticResource RadiusSmall}">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image
                            helpers:ImageLoader.DecodeWidth="40"
                            helpers:ImageLoader.Url="{x:Bind ArtUrl}"
                            Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock Style="{StaticResource HeadlineStyle}" Text="{x:Bind Title}" />
                        <TextBlock Style="{StaticResource SubheadStyle}" Text="{x:Bind Subtitle}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Style="{StaticResource FootnoteStyle}"
                        Text="{x:Bind Detail}"
                        Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Top stations: like songs, with the station logo. -->
        <DataTemplate x:Key="StationRowTemplate" x:DataType="vm:StatsRankItem">
            <Button
                AutomationProperties.Name="{x:Bind AutomationName}"
                Click="OnRankItemClick"
                Style="{StaticResource RowButtonStyle}"
                ToolTipService.ToolTip="Go to Radio">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextTertiaryBrush}"
                        Style="{StaticResource SubheadStyle}"
                        Text="{x:Bind Rank}"
                        Typography.NumeralAlignment="Tabular" />
                    <radio:StationArt
                        Grid.Column="1"
                        Width="{StaticResource RowArtSize}"
                        Height="{StaticResource RowArtSize}"
                        CornerRadius="{StaticResource RadiusSmall}"
                        LogoUrl="{x:Bind ArtUrl}"
                        StationName="{x:Bind Title}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource HeadlineStyle}"
                        Text="{x:Bind Title}" />
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Style="{StaticResource FootnoteStyle}"
                        Text="{x:Bind Detail}"
                        Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Top artists: round art (their most played cover), name, plays and time. -->
        <DataTemplate x:Key="ArtistCardTemplate" x:DataType="vm:StatsRankItem">
            <Button
                Padding="8,10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                AutomationProperties.Name="{x:Bind AutomationName}"
                Click="OnRankItemClick"
                Style="{StaticResource RowButtonStyle}"
                Height="Auto">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <Grid
                        Width="104"
                        Height="104"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource Surface2Brush}"
                        CornerRadius="{StaticResource RadiusPill}">
                        <FontIcon
                            FontSize="28"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            Glyph="&#xE77B;" />
                        <Image
                            helpers:ImageLoader.DecodeWidth="104"
                            helpers:ImageLoader.Url="{x:Bind ArtUrl}"
                            Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel Spacing="1">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource HeadlineStyle}"
                            Text="{x:Bind Title}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource FootnoteStyle}"
                            Text="{x:Bind Detail}"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Top albums: square cover, title, artist, plays and time. -->
        <DataTemplate x:Key="AlbumCardTemplate" x:DataType="vm:StatsRankItem">
            <Button
                Padding="8,10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                AutomationProperties.Name="{x:Bind AutomationName}"
                Click="OnRankItemClick"
                Style="{StaticResource RowButtonStyle}"
                Height="Auto"
                HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <Grid
                        Height="140"
                        Background="{ThemeResource Surface2Brush}"
                        CornerRadius="{StaticResource ArtCornerRadius}">
                        <FontIcon
                            FontSize="28"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            helpers:ImageLoader.DecodeWidth="140"
                            helpers:ImageLoader.Url="{x:Bind ArtUrl}"
                            Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel Spacing="1">
                        <TextBlock Style="{StaticResource HeadlineStyle}" Text="{x:Bind Title}" />
                        <TextBlock Style="{StaticResource SubheadStyle}" Text="{x:Bind Subtitle}" />
                        <TextBlock
                            Style="{StaticResource FootnoteStyle}"
                            Text="{x:Bind Detail}"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <!-- Full width up to a comfortable maximum, kept on the left like the other pages. -->
            <Grid Padding="{StaticResource PagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1160" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <!-- Title, period and the privacy note. -->
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource PageTitleStyle}"
                            Text="Your stats" />
                        <Border
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource SegmentedTrackStyle}">
                            <StackPanel
                                x:Name="PeriodTabs"
                                AutomationProperties.Name="Period"
                                Orientation="Horizontal">
                                <ToggleButton
                                    Checked="OnPeriodChecked"
                                    Content="Week"
                                    Style="{StaticResource SegmentToggleButtonStyle}"
                                    Tag="Week"
                                    ToolTipService.ToolTip="The past 7 days"
                                    Unchecked="OnPeriodUnchecked" />
                                <ToggleButton
                                    Checked="OnPeriodChecked"
                                    Content="Month"
                                    IsChecked="True"
                                    Style="{StaticResource SegmentToggleButtonStyle}"
                                    Tag="Month"
                                    ToolTipService.ToolTip="The past 30 days"
                                    Unchecked="OnPeriodUnchecked" />
                                <ToggleButton
                                    Checked="OnPeriodChecked"
                                    Content="Year"
                                    Style="{StaticResource SegmentToggleButtonStyle}"
                                    Tag="Year"
                                    ToolTipService.ToolTip="The past 12 months"
                                    Unchecked="OnPeriodUnchecked" />
                                <ToggleButton
                                    Checked="OnPeriodChecked"
                                    Content="All time"
                                    Style="{StaticResource SegmentToggleButtonStyle}"
                                    Tag="AllTime"
                                    Unchecked="OnPeriodUnchecked" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel
                        Margin="0,6,0,0"
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            Glyph="&#xE72E;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MetaTextStyle}"
                            Text="Stored only on this PC. Nothing is sent anywhere." />
                        <Button
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ClearCommand}"
                            Content="Clear statistics…"
                            Style="{StaticResource TextActionButtonStyle}" />
                    </StackPanel>

                    <ProgressRing
                        Margin="0,80,0,0"
                        IsActive="{x:Bind ViewModel.ShowLoading, Mode=OneWay}"
                        Style="{StaticResource LoadingRingStyle}"
                        Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay}" />

                    <items:EmptyState
                        Margin="0,64,0,0"
                        ActionText="Try again"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Glyph="&#xE783;"
                        Heading="Couldn't load your stats"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />

                    <items:EmptyState
                        Margin="0,64,0,0"
                        Glyph="&#xE9D2;"
                        Heading="No listening yet"
                        Message="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                        Visibility="{x:Bind helpers:Format.VisibleIfAndNot(ViewModel.IsEmpty, ViewModel.ShowLoading), Mode=OneWay}" />

                    <StackPanel Visibility="{x:Bind helpers:Format.VisibleIfAndNot(ViewModel.HasContent, ViewModel.IsEmpty), Mode=OneWay}">
                        <ItemsRepeater
                            Margin="0,28,0,0"
                            ItemTemplate="{StaticResource TileTemplate}"
                            ItemsSource="{x:Bind ViewModel.Tiles, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="4"
                                    MinColumnSpacing="12"
                                    MinItemWidth="200"
                                    MinRowSpacing="12" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <StackPanel
                            Margin="0,40,0,0"
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.HasTopArtists, Mode=OneWay}">
                            <items:SectionHeader Title="Top artists" />
                            <ItemsRepeater
                                Margin="-8,0"
                                ItemTemplate="{StaticResource ArtistCardTemplate}"
                                ItemsSource="{x:Bind ViewModel.TopArtists, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MaximumRowsOrColumns="6"
                                        MinColumnSpacing="4"
                                        MinItemWidth="140"
                                        MinRowSpacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                        <StackPanel
                            Margin="0,36,0,0"
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.HasTopSongs, Mode=OneWay}">
                            <items:SectionHeader Title="Top songs" />
                            <ItemsRepeater
                                Margin="-8,0"
                                ItemTemplate="{StaticResource SongRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.TopSongs, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel
                            Margin="0,36,0,0"
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.HasTopAlbums, Mode=OneWay}">
                            <items:SectionHeader Title="Top albums" />
                            <ItemsRepeater
                                Margin="-8,0"
                                ItemTemplate="{StaticResource AlbumCardTemplate}"
                                ItemsSource="{x:Bind ViewModel.TopAlbums, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MaximumRowsOrColumns="6"
                                        MinColumnSpacing="4"
                                        MinItemWidth="160"
                                        MinRowSpacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- When: by hour of day and by day of the week. -->
                        <StackPanel Margin="0,36,0,0" Spacing="10">
                            <items:SectionHeader Title="When you listen" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Padding="20,16,20,14"
                                    Background="{ThemeResource Surface1Brush}"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                    <StackPanel Spacing="14">
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource HeadlineStyle}" Text="By time of day" />
                                            <TextBlock Style="{StaticResource FootnoteStyle}" Text="{x:Bind ViewModel.HourSummary, Mode=OneWay}" />
                                        </StackPanel>
                                        <items:BarChart AutomationProperties.Name="Listening by time of day" Bars="{x:Bind ViewModel.ByHour, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="20,16,20,14"
                                    Background="{ThemeResource Surface1Brush}"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                    <StackPanel Spacing="14">
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource HeadlineStyle}" Text="By day of the week" />
                                            <TextBlock Style="{StaticResource FootnoteStyle}" Text="{x:Bind ViewModel.WeekdaySummary, Mode=OneWay}" />
                                        </StackPanel>
                                        <items:BarChart AutomationProperties.Name="Listening by day of the week" Bars="{x:Bind ViewModel.ByWeekday, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel
                            Margin="0,36,0,0"
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.HasTopStations, Mode=OneWay}">
                            <items:SectionHeader Title="Top radio stations" />
                            <ItemsRepeater
                                Margin="-8,0"
                                ItemTemplate="{StaticResource StationRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.TopStations, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <ProgressBar Style="{StaticResource BusyBarStyle}" Visibility="{x:Bind ViewModel.ShowBusyBar, Mode=OneWay}" />
    </Grid>
</Page>
