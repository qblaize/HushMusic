<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HushMusic.App.Views.Pages.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:items="using:HushMusic.App.Controls.Items"
    xmlns:models="using:HushMusic.Core.Models"
    xmlns:pages="using:HushMusic.App.Views.Pages"
    xmlns:vm="using:HushMusic.App.ViewModels.Pages"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Chart rows: the chart position, then a compact track row. -->
        <DataTemplate x:Key="RankedTrackTemplate" x:DataType="vm:TrackItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Style="{StaticResource HeadlineStyle}"
                    Text="{x:Bind items:ItemFormat.Number(Number)}" />
                <items:TrackRow
                    Grid.Column="1"
                    Item="{x:Bind}"
                    ShowAlbum="False" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MoodTileTemplate" x:DataType="models:MoodCategory">
            <pages:ExploreMoodTile Category="{x:Bind}" Click="OnMoodClick" />
        </DataTemplate>

        <UniformGridLayout
            x:Key="MoodTileLayout"
            ItemsStretch="Fill"
            MinColumnSpacing="12"
            MinItemHeight="52"
            MinItemWidth="176"
            MinRowSpacing="12" />
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller">
            <StackPanel Padding="{StaticResource PagePadding}">
                <Grid>
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource PageTitleStyle}"
                        Text="Explore" />
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Refresh"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Refresh (F5)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <!-- First load: a shelf of cards, chart rows, tiles. -->
                <items:Skeleton Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay}">
                    <StackPanel>
                        <StackPanel Margin="0,32,0,0" Spacing="16">
                            <Border
                                Width="148"
                                Height="18"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SkeletonBlockStyle}" />
                            <items:SkeletonCards />
                        </StackPanel>
                        <StackPanel Margin="0,40,0,0" Spacing="12">
                            <Border
                                Width="112"
                                Height="18"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SkeletonBlockStyle}" />
                            <items:SkeletonRows Margin="-8,0" Count="5" />
                        </StackPanel>
                        <StackPanel Margin="0,40,0,0" Spacing="16">
                            <Border
                                Width="172"
                                Height="18"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SkeletonBlockStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind SkeletonTiles}" Layout="{StaticResource MoodTileLayout}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:Int32">
                                        <Border CornerRadius="{StaticResource RadiusMedium}" Style="{StaticResource SkeletonArtStyle}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </items:Skeleton>

                <StackPanel items:Reveal.IsShown="{x:Bind ViewModel.HasContent, Mode=OneWay}">
                    <!-- New albums & singles -->
                    <StackPanel
                        Margin="0,32,0,0"
                        Spacing="14"
                        Visibility="{x:Bind ViewModel.HasNewReleases, Mode=OneWay}">
                        <items:SectionHeader
                            Title="New releases"
                            ActionText="See all"
                            Command="{x:Bind ViewModel.SeeAllNewReleasesCommand}" />
                        <items:Carousel ItemClick="OnItemClick" ItemsSource="{x:Bind ViewModel.NewReleases}" />
                    </StackPanel>

                    <!-- Trending (Top songs for Premium accounts): ranked rows, two columns when there is room. -->
                    <StackPanel
                        Margin="0,40,0,0"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.HasChartTracks, Mode=OneWay}">
                        <items:SectionHeader
                            Title="{x:Bind ViewModel.ChartTitle, Mode=OneWay}"
                            ActionText="See all"
                            Command="{x:Bind ViewModel.SeeAllChartSongsCommand}" />
                        <GridView
                            x:Name="ChartGrid"
                            Margin="-8,0"
                            Padding="0"
                            IsItemClickEnabled="True"
                            ItemClick="OnChartTrackClick"
                            ItemContainerStyle="{StaticResource GridTrackRowContainerStyle}"
                            ItemTemplate="{StaticResource RankedTrackTemplate}"
                            ItemsSource="{x:Bind ViewModel.ChartTracks}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None"
                            SizeChanged="OnChartGridSizeChanged"
                            items:TrackDrag.IsEnabled="True"
                            items:TrackMenu.IsEnabled="True">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemHeight="{StaticResource RowHeight}" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>

                    <!-- Moods & genres: tinted tiles. -->
                    <StackPanel
                        Margin="0,40,0,0"
                        Spacing="14"
                        Visibility="{x:Bind ViewModel.HasMoods, Mode=OneWay}">
                        <items:SectionHeader
                            Title="Moods &amp; genres"
                            ActionText="See all"
                            Command="{x:Bind ViewModel.SeeAllMoodsCommand}" />
                        <ItemsRepeater
                            ItemTemplate="{StaticResource MoodTileTemplate}"
                            ItemsSource="{x:Bind ViewModel.Moods}"
                            Layout="{StaticResource MoodTileLayout}" />
                    </StackPanel>

                    <!-- Charts of a country: top artists and the chart playlists. -->
                    <StackPanel Margin="0,48,0,0" Visibility="{x:Bind ViewModel.HasCharts, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Bottom"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource Title2Style}"
                                Text="Charts" />
                            <ProgressRing
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                IsActive="{x:Bind ViewModel.IsChartsBusy, Mode=OneWay}" />
                            <ComboBox
                                Grid.Column="2"
                                MinWidth="200"
                                MaxDropDownHeight="420"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Chart country"
                                CornerRadius="{StaticResource RadiusMedium}"
                                ItemsSource="{x:Bind ViewModel.Countries}"
                                SelectedIndex="{x:Bind ViewModel.SelectedCountryIndex, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CountryOption">
                                        <TextBlock Text="{x:Bind Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <StackPanel
                            Margin="0,24,0,0"
                            Spacing="14"
                            Visibility="{x:Bind ViewModel.HasTopArtists, Mode=OneWay}">
                            <items:SectionHeader
                                Title="Top artists"
                                ActionText="See all"
                                Command="{x:Bind ViewModel.SeeAllChartsCommand}" />
                            <items:Carousel ItemClick="OnItemClick" ItemsSource="{x:Bind ViewModel.TopArtists}" />
                        </StackPanel>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PlaylistCharts}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:Shelf">
                                    <StackPanel Margin="0,36,0,0" Spacing="14">
                                        <items:SectionHeader Title="{x:Bind Title}" />
                                        <items:Carousel ItemClick="OnItemClick" ItemsSource="{x:Bind Items}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- New music videos -->
                    <StackPanel
                        Margin="0,48,0,0"
                        Spacing="14"
                        Visibility="{x:Bind ViewModel.HasNewVideos, Mode=OneWay}">
                        <items:SectionHeader
                            Title="New music videos"
                            ActionText="See all"
                            Command="{x:Bind ViewModel.SeeAllNewVideosCommand}" />
                        <items:Carousel ItemClick="OnItemClick" ItemsSource="{x:Bind ViewModel.NewVideos}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar Style="{StaticResource BusyBarStyle}" Visibility="{x:Bind ViewModel.ShowBusyBar, Mode=OneWay}" />
        <items:EmptyState
            ActionText="Try again"
            Command="{x:Bind ViewModel.RetryCommand}"
            Glyph="&#xE783;"
            Heading="Couldn't load Explore"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />
        <items:EmptyState
            ActionText="Refresh"
            Command="{x:Bind ViewModel.RefreshCommand}"
            Glyph="&#xE909;"
            Heading="Nothing here yet"
            Message="YouTube Music didn't return anything to explore."
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
