<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Items.MediaCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:items="using:HushMusic.App.Controls.Items"
    PointerCanceled="OnPointerExited"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited">

    <StackPanel x:Name="Root" Width="{StaticResource CardArtSize}">
        <!-- Artwork only, no card container. Hover lifts it (scale + elevation shadow) and reveals the play button. -->
        <Grid
            x:Name="ArtHost"
            Width="{StaticResource CardArtSize}"
            Height="{StaticResource CardArtSize}"
            Margin="0,0,0,10"
            Background="{ThemeResource Surface2Brush}"
            CornerRadius="{StaticResource ArtCornerRadius}">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextTertiaryBrush}"
                Glyph="{x:Bind items:ItemFormat.PlaceholderGlyph(Item), Mode=OneWay}" />
            <Image
                x:Name="ArtImage"
                helpers:ImageLoader.Url="{x:Bind items:ItemFormat.CardArt(Item), Mode=OneWay}"
                Stretch="UniformToFill" />
            <Border
                x:Name="Scrim"
                Background="{StaticResource ArtHoverScrimBrush}"
                IsHitTestVisible="False"
                Opacity="0">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Border.OpacityTransition>
            </Border>
            <!-- Songs dragged over one of your playlists: an accent ring says "drop here". -->
            <Border
                x:Name="DropRing"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="3"
                CornerRadius="{StaticResource ArtCornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            <Button
                x:Name="PlayButton"
                Margin="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Play"
                Click="OnPlayClick"
                IsHitTestVisible="False"
                IsTabStop="False"
                Opacity="0"
                Style="{StaticResource CardPlayButtonStyle}"
                ToolTipService.ToolTip="Play">
                <Button.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Button.OpacityTransition>
                <FontIcon FontSize="14" Glyph="&#xF5B0;" />
            </Button>
        </Grid>
        <TextBlock
            x:Name="TitleText"
            MaxLines="2"
            Style="{StaticResource HeadlineStyle}"
            Text="{x:Bind items:ItemFormat.Title(Item), Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="SubtitleText"
            Margin="0,2,0,0"
            Style="{StaticResource SubheadStyle}"
            Text="{x:Bind items:ItemFormat.CardSubtitle(Item), Mode=OneWay}" />
    </StackPanel>
</UserControl>
