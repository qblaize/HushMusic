<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.NowPlaying.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:local="using:HushMusic.App.Controls.NowPlaying"
    IsTabStop="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/NowPlaying/NowPlayingResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ProgressRing
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextSecondaryBrush}"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />

        <!--  Error  -->
        <StackPanel
            Margin="32,0,32,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasError), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,6"
                FontSize="28"
                Foreground="{ThemeResource TextTertiaryBrush}"
                Glyph="&#xEA39;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource HeadlineStyle}"
                Text="Couldn't load the lyrics" />
            <TextBlock
                HorizontalAlignment="Center"
                MaxLines="3"
                Style="{StaticResource SubheadStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.RetryCommand}"
                Content="Try again"
                Style="{StaticResource PillSecondaryButtonStyle}" />
        </StackPanel>

        <!--  Empty  -->
        <StackPanel
            Margin="32,0,32,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ViewModel.Message), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,6"
                FontSize="28"
                Foreground="{ThemeResource TextTertiaryBrush}"
                Glyph="&#xE8BD;" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="NowPlayingLyricsMessage"
                Style="{StaticResource HeadlineStyle}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextTrimming="None"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--
            Synced: big bold lines; the current one bright and kept about a third of the way down, its words lighting up as
            they are sung (LyricsStage). The lines are built in code and reused for the next song.
        -->
        <ScrollView
            x:Name="SyncedScroller"
            AutomationProperties.AutomationId="NowPlayingSyncedLyrics"
            AutomationProperties.Name="Lyrics"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Hidden"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsSynced), Mode=OneWay}"
            ZoomMode="Disabled">
            <StackPanel x:Name="SyncedContent" Padding="8,16,12,0">
                <StackPanel x:Name="LinesHost" />
                <local:LyricsFooter x:Name="SyncedFooter" Margin="12,28,12,0" />
            </StackPanel>
        </ScrollView>

        <!--  Unsynced: calm, plain, selectable text.  -->
        <ScrollViewer
            x:Name="PlainScroller"
            Padding="20,12,24,32"
            AutomationProperties.AutomationId="NowPlayingPlainLyrics"
            HorizontalScrollMode="Disabled"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsPlain), Mode=OneWay}">
            <StackPanel Spacing="28">
                <!--  One paragraph per lyric line, so a wrapped line reads as one; a blank line opens a new verse.  -->
                <RichTextBlock
                    x:Name="PlainText"
                    AutomationProperties.AutomationId="NowPlayingPlainLyricsText"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource LyricsPlainTextStyle}" />
                <local:LyricsFooter />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
