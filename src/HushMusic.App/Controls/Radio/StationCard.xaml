<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Radio.StationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:items="using:HushMusic.App.Controls.Items"
    xmlns:radio="using:HushMusic.App.Controls.Radio"
    IsTabStop="False"
    PointerCanceled="OnPointerExited"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited">

    <UserControl.Resources>
        <!--  The whole card plays the station: no chrome, dims a little when pressed.  -->
        <Style x:Key="StationCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{StaticResource ArtCornerRadius}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Background="{TemplateBinding Background}"
                            Content="{TemplateBinding Content}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Small round glass button on the artwork (favourite).  -->
        <Style x:Key="StationArtIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NowPlayingScrimBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnArtForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.85" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.65" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Width="{StaticResource CardArtSize}">
        <Grid.ContextFlyout>
            <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource AppMenuFlyoutPresenterStyle}">
                <MenuFlyoutItem
                    Command="{x:Bind Item.PlayCommand, Mode=OneWay}"
                    Style="{StaticResource AppMenuFlyoutItemStyle}"
                    Text="Play">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    Command="{x:Bind Item.ToggleFavoriteCommand, Mode=OneWay}"
                    Style="{StaticResource AppMenuFlyoutItemStyle}"
                    Text="{x:Bind Item.FavoriteLabel, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="{x:Bind Item.FavoriteGlyph, Mode=OneWay}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Command="{x:Bind Item.OpenWebsiteCommand, Mode=OneWay}"
                    Style="{StaticResource AppMenuFlyoutItemStyle}"
                    Text="Open website">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <VisualStateManager.VisualStateGroups>
            <!--  Explicit storyboards, not implicit transitions: those crash when they fire during layout.  -->
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Rest">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="Scrim"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0:0:0.15" />
                        <DoubleAnimation
                            Storyboard.TargetName="PlayButton"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0:0:0.15" />
                        <DoubleAnimation
                            Storyboard.TargetName="FavoriteButton"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0:0:0.15" />
                        <DoubleAnimation
                            Storyboard.TargetName="FavoriteMark"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0:0:0.15" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Hover">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="Scrim"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0:0:0.15" />
                        <DoubleAnimation
                            Storyboard.TargetName="PlayButton"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0:0:0.15" />
                        <DoubleAnimation
                            Storyboard.TargetName="FavoriteButton"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0:0:0.15" />
                        <DoubleAnimation
                            Storyboard.TargetName="FavoriteMark"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0:0:0.15" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Button
            x:Name="CardButton"
            AutomationProperties.AutomationId="StationCard"
            AutomationProperties.HelpText="{x:Bind Item.Tags, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Item.Name, Mode=OneWay}"
            Command="{x:Bind Item.PlayCommand, Mode=OneWay}"
            Style="{StaticResource StationCardButtonStyle}">
            <StackPanel>
                <Grid
                    Width="{StaticResource CardArtSize}"
                    Height="{StaticResource CardArtSize}"
                    Margin="0,0,0,10"
                    Background="{ThemeResource Surface2Brush}"
                    CornerRadius="{StaticResource ArtCornerRadius}">
                    <radio:StationArt LogoUrl="{x:Bind Item.LogoUrl, Mode=OneWay}" StationName="{x:Bind Item.Name, Mode=OneWay}" />
                    <Border
                        x:Name="Scrim"
                        Background="{StaticResource ArtHoverScrimBrush}"
                        IsHitTestVisible="False"
                        Opacity="0" />
                    <!--  The station that is on: equaliser over a dimmed logo.  -->
                    <Grid IsHitTestVisible="False" Visibility="{x:Bind helpers:Format.VisibleIf(Item.IsCurrent), Mode=OneWay}">
                        <Border Background="{StaticResource NowPlayingScrimBrush}" />
                        <items:NowPlayingIndicator Foreground="{StaticResource OnArtForegroundBrush}" IsPlaying="{x:Bind Item.IsPlaying, Mode=OneWay}" />
                    </Grid>
                    <Border
                        BorderBrush="{ThemeResource SeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ArtCornerRadius}"
                        IsHitTestVisible="False" />
                </Grid>
                <TextBlock Style="{StaticResource HeadlineStyle}" Text="{x:Bind Item.Name, Mode=OneWay}" />
                <TextBlock
                    Margin="0,2,0,0"
                    Style="{StaticResource SubheadStyle}"
                    Text="{x:Bind Item.Tags, Mode=OneWay}"
                    Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(Item.Tags), Mode=OneWay}" />
                <!--  "● LIVE  Germany · 192 kbps MP3"  -->
                <StackPanel
                    Margin="0,3,0,0"
                    Orientation="Horizontal"
                    Spacing="5">
                    <Ellipse
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{StaticResource AccentBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        CharacterSpacing="40"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AccentBrush}"
                        Style="{StaticResource FootnoteStyle}"
                        Text="LIVE" />
                    <TextBlock
                        MaxWidth="128"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextTertiaryBrush}"
                        Style="{StaticResource FootnoteStyle}"
                        Text="{x:Bind Item.Details, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Button>

        <!--  Over the artwork, as siblings of the card button (buttons can't nest): favourite and play.  -->
        <Grid Height="{StaticResource CardArtSize}" VerticalAlignment="Top">
            <FontIcon
                x:Name="FavoriteMark"
                Margin="0,14,14,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{StaticResource OnArtForegroundBrush}"
                Glyph="&#xEB52;"
                IsHitTestVisible="False"
                Visibility="{x:Bind helpers:Format.VisibleIf(Item.IsFavorite), Mode=OneWay}" />
            <Button
                x:Name="FavoriteButton"
                Margin="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="{x:Bind Item.FavoriteLabel, Mode=OneWay}"
                Command="{x:Bind Item.ToggleFavoriteCommand, Mode=OneWay}"
                IsHitTestVisible="False"
                Opacity="0"
                Style="{StaticResource StationArtIconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind Item.FavoriteLabel, Mode=OneWay}">
                <FontIcon FontSize="13" Glyph="{x:Bind Item.FavoriteGlyph, Mode=OneWay}" />
            </Button>
            <Button
                x:Name="PlayButton"
                Margin="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="{x:Bind Item.PlayLabel, Mode=OneWay}"
                Command="{x:Bind Item.PlayCommand, Mode=OneWay}"
                IsHitTestVisible="False"
                IsTabStop="False"
                Opacity="0"
                Style="{StaticResource CardPlayButtonStyle}"
                ToolTipService.ToolTip="Play">
                <FontIcon FontSize="14" Glyph="&#xF5B0;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
