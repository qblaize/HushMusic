<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Shell.NavigationRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:HushMusic.App.Controls.Shell"
    xmlns:vmshell="using:HushMusic.App.ViewModels.Shell"
    Width="{StaticResource SidebarWidth}">

    <!--  Fixed-width icon rail. It never expands; labels appear next to the icons on hover (see ShellPage).  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!--  Pins take what is left and scroll; in a short window they shrink away first.  -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  App mark: sits in the draggable title band.  -->
        <Grid Height="{StaticResource TitleBarHeight}">
            <Image
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Source="{ThemeResource AppMarkImage}"
                Stretch="Uniform" />
        </Grid>

        <StackPanel
            x:Name="MainItems"
            Grid.Row="1"
            Margin="0,12,0,0"
            AutomationProperties.Name="Navigation"
            Spacing="6"
            TabFocusNavigation="Once"
            XYFocusKeyboardNavigation="Enabled">
            <shell:RailButton
                Command="{x:Bind ViewModel.NavigateToCommand}"
                CommandParameter="Home"
                Glyph="&#xE80F;"
                IsSelected="{x:Bind shell:ShellBindings.IsPage(ViewModel.CurrentPage, 'Home'), Mode=OneWay}"
                Label="Home"
                Style="{StaticResource RailButtonStyle}" />
            <shell:RailButton
                Command="{x:Bind ViewModel.OpenSearchCommand}"
                Glyph="&#xE721;"
                IsSelected="{x:Bind shell:ShellBindings.IsPage(ViewModel.CurrentPage, 'Search'), Mode=OneWay}"
                Label="Search"
                Shortcut="Ctrl+F"
                Style="{StaticResource RailButtonStyle}" />
            <shell:RailButton
                Command="{x:Bind ViewModel.NavigateToCommand}"
                CommandParameter="Explore"
                Glyph="&#xE909;"
                IsSelected="{x:Bind shell:ShellBindings.IsPage(ViewModel.CurrentPage, 'Explore'), Mode=OneWay}"
                Label="Explore"
                Style="{StaticResource RailButtonStyle}" />
            <shell:RailButton
                Command="{x:Bind ViewModel.NavigateToCommand}"
                CommandParameter="Radio"
                Glyph="&#xEC05;"
                IsSelected="{x:Bind shell:ShellBindings.IsPage(ViewModel.CurrentPage, 'Radio'), Mode=OneWay}"
                Label="Radio"
                Style="{StaticResource RailButtonStyle}" />
            <!-- Library and Playlists open when songs are dragged over them (their playlist cards take drops). -->
            <shell:RailButton
                AllowDrop="True"
                Command="{x:Bind ViewModel.NavigateToCommand}"
                CommandParameter="Library"
                DragEnter="OnSpringDragOver"
                DragLeave="OnSpringDragLeave"
                DragOver="OnSpringDragOver"
                Glyph="&#xE8F1;"
                IsSelected="{x:Bind shell:ShellBindings.IsPage(ViewModel.CurrentPage, 'Library'), Mode=OneWay}"
                Label="Library"
                Style="{StaticResource RailButtonStyle}" />
            <shell:RailButton
                Command="{x:Bind ViewModel.NavigateToCommand}"
                CommandParameter="LikedSongs"
                Glyph="&#xEB51;"
                IsSelected="{x:Bind shell:ShellBindings.IsPage(ViewModel.CurrentPage, 'LikedSongs'), Mode=OneWay}"
                Label="Liked songs"
                Style="{StaticResource RailButtonStyle}" />
            <shell:RailButton
                AllowDrop="True"
                Command="{x:Bind ViewModel.NavigateToCommand}"
                CommandParameter="Playlists"
                DragEnter="OnSpringDragOver"
                DragLeave="OnSpringDragLeave"
                DragOver="OnSpringDragOver"
                Glyph="&#xE90B;"
                IsSelected="{x:Bind shell:ShellBindings.IsPage(ViewModel.CurrentPage, 'Playlists'), Mode=OneWay}"
                Label="Playlists"
                Style="{StaticResource RailButtonStyle}" />
            <shell:RailButton
                Command="{x:Bind ViewModel.NavigateToCommand}"
                CommandParameter="History"
                Glyph="&#xE81C;"
                IsSelected="{x:Bind shell:ShellBindings.IsPage(ViewModel.CurrentPage, 'History'), Mode=OneWay}"
                Label="History"
                Style="{StaticResource RailButtonStyle}" />
        </StackPanel>

        <!--  Pinned playlists, albums, artists and stations. Right-click (or Shift+F10): Unpin, Move up, Move down.  -->
        <Grid
            x:Name="PinArea"
            Grid.Row="2"
            Margin="0,12"
            RowSpacing="12"
            SizeChanged="OnPinAreaSizeChanged"
            Visibility="{x:Bind Pins.HasPins, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Rectangle
                x:Name="PinDivider"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource RailDividerStyle}" />
            <ScrollViewer
                x:Name="PinScroller"
                Grid.Row="1"
                AutomationProperties.AutomationId="RailPins"
                AutomationProperties.Name="Pinned"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <!--
                    The margin keeps the focus rectangles of the first and last pin inside the scroll area. A plain
                    ItemsControl (there are at most 20 pins): an ItemsRepeater here crashed the app while a screen
                    reader walked the window.
                -->
                <ItemsControl
                    Margin="0,2"
                    IsTabStop="False"
                    ItemsSource="{x:Bind Pins.Items}"
                    TabFocusNavigation="Once"
                    XYFocusKeyboardNavigation="Enabled">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vmshell:PinItem">
                            <shell:RailButton
                                AutomationProperties.HelpText="{x:Bind Description}"
                                Command="{x:Bind OpenCommand}"
                                IsSelected="{x:Bind IsSelected, Mode=OneWay}"
                                Label="{x:Bind Title, Mode=OneWay}"
                                Loaded="OnPinLoaded"
                                Style="{StaticResource RailButtonStyle}"
                                Unloaded="OnPinUnloaded">
                                <shell:RailButton.ContextFlyout>
                                    <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource AppMenuFlyoutPresenterStyle}">
                                        <MenuFlyoutItem
                                            AutomationProperties.AutomationId="PinUnpin"
                                            Command="{x:Bind UnpinCommand}"
                                            Style="{StaticResource AppMenuFlyoutItemStyle}"
                                            Text="Unpin from sidebar">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77A;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            AutomationProperties.AutomationId="PinMoveUp"
                                            Command="{x:Bind MoveUpCommand}"
                                            Style="{StaticResource AppMenuFlyoutItemStyle}"
                                            Text="Move up">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74A;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            AutomationProperties.AutomationId="PinMoveDown"
                                            Command="{x:Bind MoveDownCommand}"
                                            Style="{StaticResource AppMenuFlyoutItemStyle}"
                                            Text="Move down">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74B;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </shell:RailButton.ContextFlyout>
                                <shell:RailPinArt
                                    Glyph="{x:Bind Glyph}"
                                    IsRound="{x:Bind IsRound}"
                                    StationLogoUrl="{x:Bind StationLogoUrl, Mode=OneWay}"
                                    StationName="{x:Bind StationName, Mode=OneWay}"
                                    Style="{StaticResource RailPinArtStyle}"
                                    Url="{x:Bind ThumbnailUrl, Mode=OneWay}" />
                            </shell:RailButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <StackPanel
            x:Name="FooterItems"
            Grid.Row="3"
            Margin="0,0,0,18"
            Spacing="6"
            TabFocusNavigation="Once"
            XYFocusKeyboardNavigation="Enabled">
            <shell:AccountButton x:Name="Account" HorizontalAlignment="Center" />
            <shell:RailButton
                Command="{x:Bind ViewModel.NavigateToCommand}"
                CommandParameter="Settings"
                Glyph="&#xE713;"
                IsSelected="{x:Bind shell:ShellBindings.IsPage(ViewModel.CurrentPage, 'Settings'), Mode=OneWay}"
                Label="Settings"
                Style="{StaticResource RailButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
