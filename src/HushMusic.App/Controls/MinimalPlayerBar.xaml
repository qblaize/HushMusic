<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.MinimalPlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:np="using:HushMusic.App.Controls.NowPlaying"
    xmlns:radio="using:HushMusic.App.Controls.Radio">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/PlayerBarResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Minimal layout: docked along the bottom of the content area, flat, with a hairline on top. Tracks dragged from
        pages can be dropped here (added to the queue).
    -->
    <Grid
        x:Name="Surface"
        Height="{StaticResource MinimalPlayerBarHeight}"
        AllowDrop="True"
        Background="{ThemeResource AppBackgroundBrush}"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ProgressStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition From="SeekSliderShown" GeneratedDuration="0:0:0.2" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="ProgressLineShown" />
                <VisualState x:Name="SeekSliderShown">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="SeekSlider"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0:0:0.12" />
                        <DoubleAnimation
                            Storyboard.TargetName="ProgressLine"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0:0:0.12" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Rectangle
            Height="1"
            VerticalAlignment="Top"
            Fill="{ThemeResource SeparatorBrush}"
            IsHitTestVisible="False" />

        <!--
            Progress: a thin accent line along the top edge, half over the page above, that turns into a seek slider while
            the pointer is on it, a drag is running or the keyboard focuses it. None for live radio. First in tab order
            (it is the topmost control), drawn over the rest.
        -->
        <Grid
            x:Name="ProgressHost"
            Height="22"
            Margin="0,-10,0,0"
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            Background="Transparent"
            PointerCanceled="OnProgressPointerLeft"
            PointerCaptureLost="OnProgressPointerLeft"
            PointerEntered="OnProgressPointerEntered"
            PointerExited="OnProgressPointerLeft"
            Visibility="{x:Bind ViewModel.IsNotLive, Mode=OneWay}">
            <Rectangle
                x:Name="ProgressLine"
                Height="2"
                VerticalAlignment="Center"
                Fill="{ThemeResource AccentTextBrush}"
                IsHitTestVisible="False"
                RenderTransformOrigin="0,0.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform ScaleX="{x:Bind Fraction(ViewModel.PositionSeconds, ViewModel.DurationSeconds), Mode=OneWay}" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Slider
                x:Name="SeekSlider"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PlayerBarSeek"
                AutomationProperties.Name="Seek"
                GotFocus="OnSeekFocusChanged"
                IsEnabled="{x:Bind ViewModel.CanSeek, Mode=OneWay}"
                IsEnabledChanged="OnSeekEnabledChanged"
                LargeChange="15"
                LostFocus="OnSeekFocusChanged"
                Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                Minimum="0"
                Opacity="0"
                SmallChange="5"
                StepFrequency="1"
                ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                Value="{x:Bind ViewModel.PositionSeconds, Mode=TwoWay}" />
        </Grid>

        <Grid Padding="16,0,16,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Now playing: artwork and title open Now Playing, artists link to their page  -->
            <Grid VerticalAlignment="Center" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    AutomationProperties.AutomationId="PlayerBarArtwork"
                    AutomationProperties.Name="Open Now Playing"
                    Command="{x:Bind NowPlaying.ToggleCommand}"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    Style="{StaticResource PlayerArtButtonStyle}"
                    ToolTipService.ToolTip="Now Playing">
                    <Grid
                        Width="{StaticResource MinimalPlayerArtSize}"
                        Height="{StaticResource MinimalPlayerArtSize}"
                        Background="{ThemeResource Surface2Brush}"
                        CornerRadius="{StaticResource RadiusSmall}">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            Glyph="&#xEC4F;" />
                        <Image
                            helpers:ImageLoader.DecodeWidth="40"
                            helpers:ImageLoader.Url="{x:Bind ViewModel.CoverUrl, Mode=OneWay}"
                            AutomationProperties.AccessibilityView="Raw"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind ViewModel.IsNotLive, Mode=OneWay}" />
                        <radio:StationArt
                            LogoUrl="{x:Bind ViewModel.LiveArtUrl, Mode=OneWay}"
                            StationName="{x:Bind ViewModel.StationName, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}" />
                        <Border
                            BorderBrush="{ThemeResource SeparatorBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}" />
                    </Grid>
                </Button>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1"
                    Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasTrack), Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  Live radio: the LIVE badge goes before the song title (no room for it above).  -->
                        <radio:LiveBadge
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="PlayerBarLive"
                            Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.AutomationId="PlayerBarTitle"
                            AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                            Command="{x:Bind NowPlaying.ToggleCommand}"
                            Style="{StaticResource ShellTitleLinkButtonStyle}"
                            ToolTipService.ToolTip="Now Playing">
                            <TextBlock Style="{StaticResource HeadlineStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                        </Button>
                    </Grid>
                    <np:CreditsText Credits="{x:Bind NowPlaying.ArtistCredits, Mode=OneWay}" TextStyle="{StaticResource SubheadStyle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1"
                    Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.HasTrack), Mode=OneWay}">
                    <TextBlock
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Style="{StaticResource HeadlineStyle}"
                        Text="Not playing" />
                    <TextBlock
                        Foreground="{ThemeResource TextTertiaryBrush}"
                        Style="{StaticResource FootnoteStyle}"
                        Text="Pick a song to start listening" />
                </StackPanel>
            </Grid>

            <!--  Transport  -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PlayerBarPrevious"
                    AutomationProperties.Name="Previous"
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    Content="&#xF8AC;"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Previous (Ctrl+Left)" />
                <Button
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PlayerBarPlayPause"
                    AutomationProperties.Name="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.PlayPauseCommand}"
                    Style="{StaticResource PlayButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Text="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                            Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.IsLoading), Mode=OneWay}" />
                        <ProgressRing
                            Width="18"
                            Height="18"
                            Foreground="{ThemeResource AppBackgroundBrush}"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PlayerBarNext"
                    AutomationProperties.Name="Next"
                    Command="{x:Bind ViewModel.NextCommand}"
                    Content="&#xF8AD;"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Next (Ctrl+Right)" />
            </StackPanel>

            <!--  Volume, then everything else in one menu  -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PlayerBarMute"
                    AutomationProperties.Name="{x:Bind ViewModel.MuteLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleMuteCommand}"
                    Content="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}"
                    FontSize="14"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.MuteLabel, Mode=OneWay}" />
                <Slider
                    Width="88"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PlayerBarVolume"
                    AutomationProperties.Name="Volume"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="2"
                    StepFrequency="1"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                <Button
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PlayerBarMore"
                    AutomationProperties.Name="More options"
                    Content="&#xE712;"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="More">
                    <Button.Flyout>
                        <MenuFlyout
                            MenuFlyoutPresenterStyle="{StaticResource AppMenuFlyoutPresenterStyle}"
                            Opening="OnMoreMenuOpening"
                            Placement="TopEdgeAlignedRight">
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="PlayerBarMenuLike"
                                Command="{x:Bind ViewModel.ToggleLikeCommand}"
                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                Text="{x:Bind ViewModel.LikeLabel, Mode=OneWay}"
                                Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.CanRate), Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="{x:Bind ViewModel.LikeGlyph, Mode=OneWay}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.CanRate), Mode=OneWay}" />
                            <ToggleMenuFlyoutItem
                                AutomationProperties.AutomationId="PlayerBarMenuShuffle"
                                Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                                IsChecked="{x:Bind ViewModel.IsShuffleEnabled, Mode=OneWay}"
                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                Text="Shuffle">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B1;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutSubItem
                                AutomationProperties.AutomationId="PlayerBarMenuRepeat"
                                Style="{StaticResource AppMenuFlyoutSubItemStyle}"
                                Text="Repeat">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}" />
                                </MenuFlyoutSubItem.Icon>
                                <!--  Unstyled: an explicit MenuFlyoutItem style leaves a RadioMenuFlyoutItem without a template.  -->
                                <RadioMenuFlyoutItem
                                    x:Name="RepeatOffItem"
                                    AutomationProperties.AutomationId="PlayerBarMenuRepeatOff"
                                    Click="OnRepeatClick"
                                    GroupName="PlayerBarRepeat"
                                    Text="Off" />
                                <RadioMenuFlyoutItem
                                    x:Name="RepeatAllItem"
                                    AutomationProperties.AutomationId="PlayerBarMenuRepeatAll"
                                    Click="OnRepeatClick"
                                    GroupName="PlayerBarRepeat"
                                    Text="All" />
                                <RadioMenuFlyoutItem
                                    x:Name="RepeatOneItem"
                                    AutomationProperties.AutomationId="PlayerBarMenuRepeatOne"
                                    Click="OnRepeatClick"
                                    GroupName="PlayerBarRepeat"
                                    Text="One" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="PlayerBarMenuLyrics"
                                Command="{x:Bind NowPlaying.ToggleLyricsCommand}"
                                IsEnabled="{x:Bind NowPlaying.CanShowLyrics, Mode=OneWay}"
                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                Text="Lyrics">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8BD;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="PlayerBarMenuUpNext"
                                Command="{x:Bind NowPlaying.ToggleUpNextCommand}"
                                IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                Text="Up next">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8FD;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem
                                x:Name="SleepTimerItem"
                                AutomationProperties.AutomationId="PlayerBarMenuSleepTimer"
                                Style="{StaticResource AppMenuFlyoutSubItemStyle}"
                                Text="{x:Bind NowPlaying.SleepTimer.Label, Mode=OneWay}">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE708;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="PlayerBarMenuMiniPlayer"
                                Command="{x:Bind NowPlaying.EnterMiniPlayerCommand}"
                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                Text="Mini player">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE92C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Shown while tracks are dragged over the bar.  -->
        <Border
            x:Name="DropHighlight"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="2"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
