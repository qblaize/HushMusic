<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Settings.HotkeyBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!--  The keys on a quiet pill. Select it and press new keys; while it waits, a keyboard glyph and accent text show it.  -->
    <Grid>
        <Button
            x:Name="Box"
            MinWidth="176"
            HorizontalContentAlignment="Center"
            Click="OnClick"
            LostFocus="OnLostFocus"
            Style="{StaticResource PillSecondaryButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    x:Name="Glyph"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Glyph="&#xE765;"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="Label"
                    VerticalAlignment="Center"
                    FontWeight="Normal"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CaptureStates">
                <VisualState x:Name="Showing" />
                <VisualState x:Name="ShowingNone">
                    <VisualState.Setters>
                        <Setter Target="Label.Foreground" Value="{ThemeResource TextTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Capturing">
                    <VisualState.Setters>
                        <Setter Target="Glyph.Visibility" Value="Visible" />
                        <Setter Target="Glyph.Foreground" Value="{ThemeResource AccentTextBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource AccentTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CapturingHint">
                    <VisualState.Setters>
                        <Setter Target="Glyph.Visibility" Value="Visible" />
                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WarningBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource WarningBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
