<?xml version="1.0" encoding="utf-8" ?>
<!--
    Windows design: the Theme.xaml tokens with stock Windows 11 (Fluent) values. Merged right after Theme.xaml when
    Settings > Design is "Windows" (see DesignSystems), so every key here wins over the Hush one; keys not redefined keep
    their Hush value. The stock keys Theme.xaml restyles (Fluent brushes, the stock type ramp, ControlCornerRadius,
    the accent) are removed from it at startup instead, so stock controls get their own values.

    Colours are the stock Fluent values (named in the comments) as plain colours, because code reads them by key
    (ThemeResources); brushes follow them through {ThemeResource}. Surfaces are opaque: they are also used as dialog,
    label and window backgrounds, where a translucent card fill would let the content behind show through.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Default = Dark. Keep it identical to "Dark". -->
        <ResourceDictionary x:Key="Default">
            <!-- SolidBackgroundFillColorBase (also Mica's fallback colour). -->
            <Color x:Key="AppBackgroundColor">#202020</Color>
            <!-- SolidBackgroundFillColorQuarternary: cards and grouped surfaces. -->
            <Color x:Key="Surface1Color">#2C2C2C</Color>
            <!-- Fills one and two steps above a card: placeholders, tracks, raised labels. -->
            <Color x:Key="Surface2Color">#333333</Color>
            <Color x:Key="Surface3Color">#3D3D3D</Color>
            <!-- DividerStrokeColorDefault -->
            <Color x:Key="SeparatorColor">#15FFFFFF</Color>
            <!-- SubtleFillColorSecondary / SubtleFillColorTertiary -->
            <Color x:Key="HoverFillColor">#0FFFFFFF</Color>
            <Color x:Key="PressedFillColor">#0AFFFFFF</Color>
            <!-- TextFillColorPrimary / Secondary / Tertiary -->
            <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#C5FFFFFF</Color>
            <Color x:Key="TextTertiaryColor">#87FFFFFF</Color>
            <!-- SystemFillColorCritical / Success / Caution -->
            <Color x:Key="DangerColor">#FF99A4</Color>
            <Color x:Key="SuccessColor">#6CCB5F</Color>
            <Color x:Key="WarningColor">#FCE100</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="Surface1Brush" Color="{ThemeResource Surface1Color}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{ThemeResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{ThemeResource Surface3Color}" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="{ThemeResource SeparatorColor}" />
            <SolidColorBrush x:Key="HoverFillBrush" Color="{ThemeResource HoverFillColor}" />
            <SolidColorBrush x:Key="PressedFillBrush" Color="{ThemeResource PressedFillColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
            <!-- ControlStrongFillColorDefault: the stock slider rail. -->
            <SolidColorBrush x:Key="SliderRailBrush" Color="#8BFFFFFF" />
            <SolidColorBrush x:Key="HighlightFillBrush" Color="{ThemeResource HoverFillColor}" />
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00202020" />
                <GradientStop Offset="0.45" Color="#26202020" />
                <GradientStop Offset="0.8" Color="#80202020" />
                <GradientStop Offset="1" Color="#00202020" />
            </LinearGradientBrush>

            <!-- The window behind the shell: Mica. -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="Transparent" />
            <!-- Floating surfaces (player bar, panels) and overlays (search, toasts): in-app and flyout acrylic. -->
            <StaticResource x:Key="GlassBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="GlassStrongBrush" ResourceKey="AcrylicBackgroundFillColorDefaultBrush" />
            <!-- Behind modals: the dimming of a ContentDialog. -->
            <StaticResource x:Key="BackdropBlurBrush" ResourceKey="SmokeFillColorDefaultBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundColor">#202020</Color>
            <Color x:Key="Surface1Color">#2C2C2C</Color>
            <Color x:Key="Surface2Color">#333333</Color>
            <Color x:Key="Surface3Color">#3D3D3D</Color>
            <Color x:Key="SeparatorColor">#15FFFFFF</Color>
            <Color x:Key="HoverFillColor">#0FFFFFFF</Color>
            <Color x:Key="PressedFillColor">#0AFFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#C5FFFFFF</Color>
            <Color x:Key="TextTertiaryColor">#87FFFFFF</Color>
            <Color x:Key="DangerColor">#FF99A4</Color>
            <Color x:Key="SuccessColor">#6CCB5F</Color>
            <Color x:Key="WarningColor">#FCE100</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="Surface1Brush" Color="{ThemeResource Surface1Color}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{ThemeResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{ThemeResource Surface3Color}" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="{ThemeResource SeparatorColor}" />
            <SolidColorBrush x:Key="HoverFillBrush" Color="{ThemeResource HoverFillColor}" />
            <SolidColorBrush x:Key="PressedFillBrush" Color="{ThemeResource PressedFillColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
            <SolidColorBrush x:Key="SliderRailBrush" Color="#8BFFFFFF" />
            <SolidColorBrush x:Key="HighlightFillBrush" Color="{ThemeResource HoverFillColor}" />
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00202020" />
                <GradientStop Offset="0.45" Color="#26202020" />
                <GradientStop Offset="0.8" Color="#80202020" />
                <GradientStop Offset="1" Color="#00202020" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="Transparent" />
            <StaticResource x:Key="GlassBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="GlassStrongBrush" ResourceKey="AcrylicBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="BackdropBlurBrush" ResourceKey="SmokeFillColorDefaultBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- SolidBackgroundFillColorBase -->
            <Color x:Key="AppBackgroundColor">#F3F3F3</Color>
            <!-- SolidBackgroundFillColorTertiary: cards stand out lighter than the window. -->
            <Color x:Key="Surface1Color">#F9F9F9</Color>
            <!-- SolidBackgroundFillColorSecondary, and one step darker: placeholders, tracks, raised labels. -->
            <Color x:Key="Surface2Color">#EEEEEE</Color>
            <Color x:Key="Surface3Color">#E3E3E3</Color>
            <Color x:Key="SeparatorColor">#0F000000</Color>
            <Color x:Key="HoverFillColor">#09000000</Color>
            <Color x:Key="PressedFillColor">#06000000</Color>
            <Color x:Key="TextPrimaryColor">#E4000000</Color>
            <Color x:Key="TextSecondaryColor">#9E000000</Color>
            <Color x:Key="TextTertiaryColor">#72000000</Color>
            <Color x:Key="DangerColor">#C42B1C</Color>
            <Color x:Key="SuccessColor">#0F7B0F</Color>
            <Color x:Key="WarningColor">#9D5D00</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="Surface1Brush" Color="{ThemeResource Surface1Color}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{ThemeResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{ThemeResource Surface3Color}" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="{ThemeResource SeparatorColor}" />
            <SolidColorBrush x:Key="HoverFillBrush" Color="{ThemeResource HoverFillColor}" />
            <SolidColorBrush x:Key="PressedFillBrush" Color="{ThemeResource PressedFillColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
            <SolidColorBrush x:Key="SliderRailBrush" Color="#72000000" />
            <SolidColorBrush x:Key="HighlightFillBrush" Color="{ThemeResource HoverFillColor}" />
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00F3F3F3" />
                <GradientStop Offset="0.45" Color="#33F3F3F3" />
                <GradientStop Offset="0.8" Color="#A6F3F3F3" />
                <GradientStop Offset="1" Color="#00F3F3F3" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="Transparent" />
            <StaticResource x:Key="GlassBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="GlassStrongBrush" ResourceKey="AcrylicBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="BackdropBlurBrush" ResourceKey="SmokeFillColorDefaultBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===== Typography: the stock control font (Segoe UI Variable) on the Fluent type ramp ===== -->
    <StaticResource x:Key="AppFontFamily" ResourceKey="ContentControlThemeFontFamily" />

    <Style x:Key="AppTextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
    </Style>

    <!-- Title, 28 SemiBold: page titles -->
    <Style x:Key="LargeTitleStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>
    <!-- Title, 28 SemiBold: detail-page titles -->
    <Style x:Key="Title1Style" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>
    <!-- Subtitle, 20 SemiBold: section titles -->
    <Style x:Key="Title2Style" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>
    <!-- Subtitle, 20 SemiBold: shelf titles -->
    <Style x:Key="Title3Style" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>
    <!-- Body Strong, 14 SemiBold: item titles -->
    <Style x:Key="HeadlineStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Body, 14 -->
    <Style x:Key="BodyStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <!-- Caption, 12 secondary: subtitles, artists -->
    <Style x:Key="SubheadStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <!-- Caption, 12 secondary: metadata, durations, footnotes -->
    <Style x:Key="FootnoteStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <!-- Caption, 12 tertiary: the line above a title -->
    <Style x:Key="EyebrowStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <!-- ===== Radii: ControlCornerRadius for controls and small surfaces, OverlayCornerRadius for cards and panels ===== -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">4</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="RadiusXL">8</CornerRadius>
</ResourceDictionary>
