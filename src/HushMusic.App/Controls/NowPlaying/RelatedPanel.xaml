<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.NowPlaying.RelatedPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:local="using:HushMusic.App.Controls.NowPlaying"
    xmlns:vm="using:HushMusic.App.ViewModels.NowPlaying"
    IsTabStop="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/NowPlaying/NowPlayingResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ProgressRing
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextSecondaryBrush}"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />

        <!--  Error  -->
        <StackPanel
            Margin="32,0,32,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasError), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,6"
                FontSize="28"
                Foreground="{ThemeResource TextTertiaryBrush}"
                Glyph="&#xEA39;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource HeadlineStyle}"
                Text="Couldn't load related music" />
            <TextBlock
                HorizontalAlignment="Center"
                MaxLines="3"
                Style="{StaticResource SubheadStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.RetryCommand}"
                Content="Try again"
                Style="{StaticResource PillSecondaryButtonStyle}" />
        </StackPanel>

        <!--  Empty  -->
        <StackPanel
            Margin="32,0,32,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ViewModel.Message), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,6"
                FontSize="28"
                Foreground="{ThemeResource TextTertiaryBrush}"
                Glyph="&#xE93C;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource HeadlineStyle}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextTrimming="None"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer
            x:Name="Scroller"
            AutomationProperties.AutomationId="NowPlayingRelated"
            AutomationProperties.Name="Related"
            HorizontalScrollMode="Disabled"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasShelves), Mode=OneWay}">
            <ItemsControl
                Margin="12,0,12,24"
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Shelves, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RelatedShelfViewModel">
                        <StackPanel Margin="0,8,0,16" Spacing="8">
                            <TextBlock
                                Margin="8,0"
                                Style="{StaticResource Title3Style}"
                                Text="{x:Bind Title}" />
                            <TextBlock
                                Margin="8,0"
                                MaxLines="8"
                                Style="{StaticResource SubheadStyle}"
                                Text="{x:Bind Description}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:Format.VisibleIf(HasDescription)}" />

                            <!--  Songs: compact rows that play.  -->
                            <ItemsControl
                                IsTabStop="False"
                                ItemsSource="{x:Bind Songs}"
                                Visibility="{x:Bind helpers:Format.VisibleIf(HasSongs)}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RelatedSongViewModel">
                                        <Button
                                            AutomationProperties.Name="{x:Bind Title}"
                                            Command="{x:Bind PlayCommand}"
                                            Style="{StaticResource NowPlayingRowButtonStyle}"
                                            ToolTipService.ToolTip="Play">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    Width="40"
                                                    Height="40"
                                                    Background="{ThemeResource Surface2Brush}"
                                                    CornerRadius="{StaticResource RadiusSmall}">
                                                    <FontIcon
                                                        FontSize="14"
                                                        Foreground="{ThemeResource TextTertiaryBrush}"
                                                        Glyph="&#xEC4F;" />
                                                    <Image
                                                        helpers:ImageLoader.DecodeWidth="40"
                                                        helpers:ImageLoader.Url="{x:Bind ArtUrl}"
                                                        Stretch="UniformToFill" />
                                                </Grid>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="1">
                                                    <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Bind Title}" />
                                                    <TextBlock Style="{StaticResource FootnoteStyle}" Text="{x:Bind Subtitle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  Albums, playlists, artists: small cards that open their page.  -->
                            <ItemsControl
                                IsTabStop="False"
                                ItemsSource="{x:Bind Cards}"
                                Visibility="{x:Bind helpers:Format.VisibleIf(HasCards)}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:CardGrid
                                            ColumnSpacing="4"
                                            Columns="3"
                                            RowSpacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RelatedCardViewModel">
                                        <Button
                                            Padding="6,6,6,8"
                                            VerticalAlignment="Stretch"
                                            VerticalContentAlignment="Top"
                                            AutomationProperties.Name="{x:Bind AutomationName}"
                                            Command="{x:Bind OpenCommand}"
                                            Style="{StaticResource NowPlayingRowButtonStyle}">
                                            <StackPanel Spacing="6">
                                                <local:SquareGrid Background="{ThemeResource Surface2Brush}" CornerRadius="{x:Bind local:RelatedPanel.ArtCorner(IsRound)}">
                                                    <FontIcon
                                                        FontSize="22"
                                                        Foreground="{ThemeResource TextTertiaryBrush}"
                                                        Glyph="{x:Bind PlaceholderGlyph}" />
                                                    <Image
                                                        helpers:ImageLoader.DecodeWidth="120"
                                                        helpers:ImageLoader.Url="{x:Bind ArtUrl}"
                                                        Stretch="UniformToFill" />
                                                </local:SquareGrid>
                                                <TextBlock
                                                    FontSize="13"
                                                    MaxLines="2"
                                                    Style="{StaticResource HeadlineStyle}"
                                                    Text="{x:Bind Title}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextTertiaryBrush}"
                                                    Style="{StaticResource FootnoteStyle}"
                                                    Text="{x:Bind Subtitle}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
