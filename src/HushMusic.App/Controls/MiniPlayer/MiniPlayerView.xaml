<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.MiniPlayer.MiniPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:mini="using:HushMusic.App.Controls.MiniPlayer"
    xmlns:np="using:HushMusic.App.ViewModels.NowPlaying"
    xmlns:radio="using:HushMusic.App.Controls.Radio"
    FontFamily="{StaticResource AppFontFamily}"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    PreviewKeyDown="OnPreviewKeyDown"
    PreviewKeyUp="OnPreviewKeyUp"
    RequestedTheme="Dark">

    <UserControl.Resources>
        <!--  Dims the artwork under the hover controls.  -->
        <SolidColorBrush x:Key="MiniDimBrush" Color="#73000000" />
        <!--  Keeps the title readable on any artwork.  -->
        <LinearGradientBrush x:Key="MiniTitleScrimBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="0.55" Color="#80000000" />
            <GradientStop Offset="1" Color="#B3000000" />
        </LinearGradientBrush>
        <Style
            x:Key="MiniIconButtonStyle"
            BasedOn="{StaticResource IconButtonStyle}"
            TargetType="Button">
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!--  Artwork fills the window. Hover (or keyboard focus) fades in the controls, Apple-style.  -->
    <Grid x:Name="Root" Background="{ThemeResource Surface1Brush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ControlStates">
                <VisualState x:Name="ControlsHidden">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="HoverLayer"
                            Storyboard.TargetProperty="Opacity"
                            To="0"
                            Duration="0:0:0.3" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="ControlsShown">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="HoverLayer"
                            Storyboard.TargetProperty="Opacity"
                            To="1"
                            Duration="0:0:0.15" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  Placeholder, concentric with the play button so the hover controls cover it.  -->
        <FontIcon
            Margin="0,0,0,24"
            FontSize="48"
            Foreground="{ThemeResource TextTertiaryBrush}"
            Glyph="&#xEC4F;" />
        <!--  Listed art first; the resized large art covers it once loaded (it can fail on other hosts).  -->
        <Image
            helpers:ImageLoader.Url="{x:Bind np:NowPlayingArt.Listed(ViewModel.Track), Mode=OneWay}"
            AutomationProperties.AccessibilityView="Raw"
            Stretch="UniformToFill"
            Visibility="{x:Bind ViewModel.IsNotLive, Mode=OneWay}" />
        <Image
            helpers:ImageLoader.Url="{x:Bind np:NowPlayingArt.Large(ViewModel.Track, 640), Mode=OneWay}"
            AutomationProperties.AccessibilityView="Raw"
            Stretch="UniformToFill"
            Visibility="{x:Bind ViewModel.IsNotLive, Mode=OneWay}" />
        <radio:StationArt
            LogoUrl="{x:Bind ViewModel.LiveArtUrl, Mode=OneWay}"
            StationName="{x:Bind ViewModel.StationName, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}" />

        <!--  The whole surface drags the window (Window.SetTitleBar); the buttons are pass-through holes.  -->
        <Border x:Name="DragRegion" Background="Transparent" />

        <Grid
            x:Name="HoverLayer"
            Background="{StaticResource MiniDimBrush}"
            Opacity="0">
            <Button
                x:Name="ExpandButton"
                Margin="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.Name="Back to full window"
                Click="OnExpandClick"
                Content="&#xEE49;"
                FontSize="14"
                Style="{StaticResource MiniIconButtonStyle}"
                ToolTipService.ToolTip="Back to full window" />
            <Button
                x:Name="CloseButton"
                Margin="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="Close"
                Click="OnCloseClick"
                Content="&#xE8BB;"
                FontSize="12"
                Style="{StaticResource MiniIconButtonStyle}"
                ToolTipService.ToolTip="Close" />

            <StackPanel
                Margin="0,0,0,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="18">
                <Button
                    x:Name="PreviousButton"
                    Width="44"
                    Height="44"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Previous"
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    Content="&#xF8AC;"
                    CornerRadius="22"
                    FontSize="20"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    Style="{StaticResource MiniIconButtonStyle}"
                    ToolTipService.ToolTip="Previous" />
                <Button
                    x:Name="PlayPauseButton"
                    Width="56"
                    Height="56"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.PlayPauseCommand}"
                    CornerRadius="28"
                    Style="{StaticResource PlayButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="22"
                            Text="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                            Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.IsLoading), Mode=OneWay}" />
                        <ProgressRing
                            Width="22"
                            Height="22"
                            Foreground="{ThemeResource AppBackgroundBrush}"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button
                    x:Name="NextButton"
                    Width="44"
                    Height="44"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Next"
                    Command="{x:Bind ViewModel.NextCommand}"
                    Content="&#xF8AD;"
                    CornerRadius="22"
                    FontSize="20"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    Style="{StaticResource MiniIconButtonStyle}"
                    ToolTipService.ToolTip="Next" />
            </StackPanel>
        </Grid>

        <!--  Title, artists and a thin progress line: always visible.  -->
        <StackPanel
            Padding="16,56,16,14"
            VerticalAlignment="Bottom"
            Background="{StaticResource MiniTitleScrimBrush}"
            IsHitTestVisible="False"
            Spacing="1">
            <radio:LiveBadge
                Margin="0,0,0,5"
                Accent="{StaticResource AccentOnDarkBrush}"
                Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}" />
            <TextBlock Style="{StaticResource HeadlineStyle}" Text="{x:Bind mini:MiniPlayerBindings.Headline(ViewModel.HasTrack, ViewModel.Title), Mode=OneWay}" />
            <TextBlock Style="{StaticResource SubheadStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
            <Border
                Height="3"
                Margin="0,10,0,0"
                Background="{ThemeResource SliderRailBrush}"
                CornerRadius="1.5"
                Visibility="{x:Bind helpers:Format.VisibleIfAndNot(ViewModel.HasTrack, ViewModel.IsLive), Mode=OneWay}">
                <Rectangle
                    Fill="{StaticResource AccentOnDarkBrush}"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform ScaleX="{x:Bind mini:MiniPlayerBindings.Fraction(ViewModel.PositionSeconds, ViewModel.DurationSeconds), Mode=OneWay}" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
