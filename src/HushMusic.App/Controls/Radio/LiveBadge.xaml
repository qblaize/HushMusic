<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Radio.LiveBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    IsHitTestVisible="False"
    IsTabStop="False">

    <!--  "• LIVE" eyebrow above the title while a radio station plays: soft accent pill, pulsing dot.  -->
    <Border
        x:Name="Pill"
        Height="16"
        Padding="6,0,7,0"
        CornerRadius="8">
        <StackPanel
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <Ellipse
                x:Name="Dot"
                Width="5"
                Height="5"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="Label"
                VerticalAlignment="Center"
                AutomationProperties.Name="Live"
                CharacterSpacing="60"
                FontFamily="{StaticResource AppFontFamily}"
                FontSize="10"
                FontWeight="SemiBold"
                Text="LIVE"
                TextLineBounds="Tight" />
        </StackPanel>
    </Border>
</UserControl>
