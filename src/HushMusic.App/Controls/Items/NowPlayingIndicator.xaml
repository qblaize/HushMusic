<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Items.NowPlayingIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsHitTestVisible="False"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <UserControl.Resources>
        <!-- RenderTransform animations run on the compositor, so the bars keep moving while the UI thread is busy. -->
        <Storyboard x:Name="Bounce">
            <DoubleAnimation
                AutoReverse="True"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar1"
                Storyboard.TargetProperty="ScaleY"
                From="0.3"
                To="1"
                Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                AutoReverse="True"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar2"
                Storyboard.TargetProperty="ScaleY"
                From="0.85"
                To="0.25"
                Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                AutoReverse="True"
                RepeatBehavior="Forever"
                Storyboard.TargetName="Bar3"
                Storyboard.TargetProperty="ScaleY"
                From="0.45"
                To="0.95"
                Duration="0:0:0.36">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel
        Height="14"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="2">
        <Rectangle
            Width="3"
            Height="14"
            Fill="{x:Bind Foreground, Mode=OneWay}"
            RadiusX="1.5"
            RadiusY="1.5"
            RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="Bar1" ScaleY="0.55" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle
            Width="3"
            Height="14"
            Fill="{x:Bind Foreground, Mode=OneWay}"
            RadiusX="1.5"
            RadiusY="1.5"
            RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="Bar2" ScaleY="0.9" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle
            Width="3"
            Height="14"
            Fill="{x:Bind Foreground, Mode=OneWay}"
            RadiusX="1.5"
            RadiusY="1.5"
            RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="Bar3" ScaleY="0.65" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </StackPanel>
</UserControl>
