<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HushMusic.App.Views.Pages.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:items="using:HushMusic.App.Controls.Items">

    <Grid items:TrackMenu.Host="{x:Bind ViewModel}">
        <!--
            Your own playlists: drag a song to reorder it (saved to the playlist right away); not while the songs are
            filtered or sorted.
        -->
        <ListView
            Padding="{StaticResource ListPagePadding}"
            AllowDrop="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
            CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
            DragItemsCompleted="OnDragItemsCompleted"
            DragItemsStarting="OnDragItemsStarting"
            IsItemClickEnabled="True"
            ItemClick="OnTrackClick"
            ItemContainerStyle="{StaticResource TrackRowContainerStyle}"
            ItemTemplate="{StaticResource TrackRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Filter.Rows}"
            SelectionMode="None"
            Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.ShowError), Mode=OneWay}"
            items:ListFooter.FollowsItems="True"
            items:TrackDrag.IsEnabled="True"
            items:TrackMenu.IsEnabled="True"
            items:TrackSelectionList.Selection="{x:Bind ViewModel.Selection}">
            <!--
                The stock transitions without add/delete: filtering and sorting change many rows at once, and fading them
                out and back in left the list blank for a moment.
            -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <ContentThemeTransition />
                    <ReorderThemeTransition />
                    <EntranceThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.Header>
                <!-- Reaches the page edges (undoes the list padding) so the artwork wash spans the whole width. -->
                <StackPanel>
                    <items:DetailHeader
                        x:Name="Header"
                        Title="{x:Bind ViewModel.Title, Mode=OneWay}"
                        Margin="-32,-28,-32,16"
                        ArtUrl="{x:Bind ViewModel.ArtUrl, Mode=OneWay}"
                        Artists="{x:Bind ViewModel.Authors, Mode=OneWay}"
                        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
                        Eyebrow="{x:Bind ViewModel.Kicker, Mode=OneWay}"
                        IsLoading="{x:Bind ViewModel.ShowLoading, Mode=OneWay}"
                        PlaceholderGlyph="&#xE90B;"
                        PreviewArtUrl="{x:Bind ViewModel.PreviewArtUrl, Mode=OneWay}">
                        <items:DetailHeader.Actions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    AutomationProperties.Name="Play"
                                    Command="{x:Bind ViewModel.PlayCommand}"
                                    Style="{StaticResource PillButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xF5B0;" />
                                        <TextBlock Text="Play" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.Name="Shuffle"
                                    Command="{x:Bind ViewModel.ShuffleCommand}"
                                    Style="{StaticResource PillSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="13" Glyph="&#xE8B1;" />
                                        <TextBlock Text="Shuffle" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.Name="Edit playlist"
                                    Command="{x:Bind ViewModel.EditCommand}"
                                    Style="{StaticResource PillSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Edit title, description and privacy"
                                    Visibility="{x:Bind ViewModel.IsOwned, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="13" Glyph="&#xE70F;" />
                                        <TextBlock Text="Edit" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind ViewModel.Selection.ModeButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.Selection.ToggleModeCommand}"
                                    Style="{StaticResource PillSecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Select several songs (or Ctrl-click them)"
                                    Visibility="{x:Bind ViewModel.HasContent, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="13" Glyph="&#xE762;" />
                                        <TextBlock Text="{x:Bind ViewModel.Selection.ModeButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.Name="More options"
                                    CornerRadius="18"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="More options">
                                    <FontIcon Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource AppMenuFlyoutPresenterStyle}" Placement="BottomEdgeAlignedLeft">
                                            <MenuFlyoutItem
                                                Command="{x:Bind ViewModel.PlayNextCommand}"
                                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                                Text="Play next">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE893;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Command="{x:Bind ViewModel.AddToQueueCommand}"
                                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                                Text="Add to queue">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8FD;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                Command="{x:Bind ViewModel.AddToPlaylistCommand}"
                                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                                Text="Add to playlist…"
                                                Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE710;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.IsOwned, Mode=OneWay}" />
                                            <MenuFlyoutItem
                                                AutomationProperties.Name="Delete playlist"
                                                Command="{x:Bind ViewModel.DeleteCommand}"
                                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                                Text="Delete playlist…"
                                                Visibility="{x:Bind ViewModel.IsOwned, Mode=OneWay}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </items:DetailHeader.Actions>
                    </items:DetailHeader>
                    <items:TrackListToolbar
                        Margin="8,0,8,16"
                        Filter="{x:Bind ViewModel.Filter}"
                        Visibility="{x:Bind helpers:Format.VisibleIfAndNot(ViewModel.HasContent, ViewModel.IsEmpty), Mode=OneWay}" />
                    <!-- First load (a ListView keeps its Footer at the bottom of the window, so not there). -->
                    <items:Skeleton Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay}">
                        <items:SkeletonRows Count="10" />
                    </items:Skeleton>
                </StackPanel>
            </ListView.Header>
            <ListView.Footer>
                <StackPanel Spacing="12">
                    <!-- Later pages of a long playlist. -->
                    <items:Skeleton Visibility="{x:Bind ViewModel.Filter.ShowLoadingRows, Mode=OneWay}">
                        <items:SkeletonRows Count="3" />
                    </items:Skeleton>
                    <items:EmptyState
                        ActionText="Clear filter"
                        Command="{x:Bind ViewModel.Filter.ClearFilterCommand}"
                        Glyph="&#xE721;"
                        Heading="{x:Bind ViewModel.Filter.NoMatchesText, Mode=OneWay}"
                        Message="Try another title, artist or album."
                        Visibility="{x:Bind ViewModel.Filter.ShowNoMatches, Mode=OneWay}" />
                    <TextBlock
                        Margin="8,24,8,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubheadStyle}"
                        Text="This playlist is empty."
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                    <!-- The whole playlist's numbers: not under a filtered list. -->
                    <TextBlock
                        Margin="8,4,8,0"
                        Style="{StaticResource MetaTextStyle}"
                        Text="{x:Bind ViewModel.Stats, Mode=OneWay}"
                        Visibility="{x:Bind helpers:Format.CollapsedIfAny(ViewModel.Tracks.HasMoreItems, ViewModel.Filter.IsFiltered), Mode=OneWay}" />
                </StackPanel>
            </ListView.Footer>
        </ListView>

        <ProgressBar Style="{StaticResource BusyBarStyle}" Visibility="{x:Bind ViewModel.ShowProgress, Mode=OneWay}" />
        <items:SelectionBar Selection="{x:Bind ViewModel.Selection}" />
        <items:EmptyState
            ActionText="Try again"
            Command="{x:Bind ViewModel.RetryCommand}"
            Glyph="&#xE783;"
            Heading="Couldn't load this playlist"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />
    </Grid>
</Page>
