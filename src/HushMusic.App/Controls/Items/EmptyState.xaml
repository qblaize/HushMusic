<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Items.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

    <StackPanel
        MaxWidth="360"
        Padding="24"
        Spacing="6">
        <FontIcon
            Margin="0,0,0,10"
            FontSize="40"
            Foreground="{ThemeResource TextTertiaryBrush}"
            Glyph="{x:Bind Glyph, Mode=OneWay}" />
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource Title3Style}"
            Text="{x:Bind Heading, Mode=OneWay}"
            TextAlignment="Center"
            TextTrimming="None"
            TextWrapping="Wrap" />
        <TextBlock
            HorizontalAlignment="Center"
            LineHeight="19"
            Style="{StaticResource SubheadStyle}"
            Text="{x:Bind Message, Mode=OneWay}"
            TextAlignment="Center"
            TextTrimming="None"
            TextWrapping="Wrap"
            Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(Message), Mode=OneWay}" />
        <Button
            Margin="0,14,0,0"
            HorizontalAlignment="Center"
            Command="{x:Bind Command, Mode=OneWay}"
            Content="{x:Bind ActionText, Mode=OneWay}"
            Style="{StaticResource PillSecondaryButtonStyle}"
            Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ActionText), Mode=OneWay}" />
    </StackPanel>
</UserControl>
