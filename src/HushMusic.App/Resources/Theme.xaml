            <!-- Selected segment of a segmented control (raised: white on light, like macOS). -->
            <Color x:Key="SegmentSelectedFillColor">#28282C</Color>
            <Color x:Key="SegmentSelectedStrokeColor">#1AFFFFFF</Color>
            <Color x:Key="SegmentSelectedShadowColor">#00000000</Color>
            <Color x:Key="ToolTipSurfaceColor">#28282C</Color>
            <Color x:Key="ToolTipTextColor">#F5F5F7</Color>
            <Color x:Key="ToolTipStrokeColor">#00000000</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="Surface1Brush" Color="{ThemeResource Surface1Color}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{ThemeResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{ThemeResource Surface3Color}" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="{ThemeResource SeparatorColor}" />
            <SolidColorBrush x:Key="HoverFillBrush" Color="{ThemeResource HoverFillColor}" />
            <SolidColorBrush x:Key="PressedFillBrush" Color="{ThemeResource PressedFillColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
            <SolidColorBrush x:Key="ToggleOffFillBrush" Color="{ThemeResource ToggleOffFillColor}" />
            <SolidColorBrush x:Key="ToggleKnobShadowBrush" Color="{ThemeResource ToggleKnobShadowColor}" />
            <SolidColorBrush x:Key="ToggleKnobStrokeBrush" Color="{ThemeResource ToggleKnobStrokeColor}" />
            <SolidColorBrush x:Key="SegmentSelectedFillBrush" Color="{ThemeResource SegmentSelectedFillColor}" />
            <SolidColorBrush x:Key="SegmentSelectedStrokeBrush" Color="{ThemeResource SegmentSelectedStrokeColor}" />
            <SolidColorBrush x:Key="SegmentSelectedShadowBrush" Color="{ThemeResource SegmentSelectedShadowColor}" />
            <SolidColorBrush x:Key="ToolTipSurfaceBrush" Color="{ThemeResource ToolTipSurfaceColor}" />
            <SolidColorBrush x:Key="ToolTipTextBrush" Color="{ThemeResource ToolTipTextColor}" />
            <SolidColorBrush x:Key="ToolTipStrokeBrush" Color="{ThemeResource ToolTipStrokeColor}" />
            <SolidColorBrush x:Key="SliderRailBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="HighlightFillBrush" Color="#1AFFFFFF" />
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#000B0B0C" />
                <GradientStop Offset="0.45" Color="#260B0B0C" />
                <GradientStop Offset="0.8" Color="#800B0B0C" />
                <GradientStop Offset="1" Color="#000B0B0C" />
            </LinearGradientBrush>

            <AcrylicBrush
                x:Key="GlassBrush"
                FallbackColor="#F0151517"
                TintColor="#141416"
                TintLuminosityOpacity="0.85"
                TintOpacity="0.55" />
            <AcrylicBrush
                x:Key="GlassStrongBrush"
                FallbackColor="#F5151517"
                TintColor="#121214"
                TintLuminosityOpacity="0.9"
                TintOpacity="0.72" />
            <AcrylicBrush
                x:Key="BackdropBlurBrush"
                FallbackColor="#D9000000"
                TintColor="#000000"
                TintLuminosityOpacity="0.5"
                TintOpacity="0.4" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0B0B0C" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0B0B0C" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F5F5F7" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A1A1A6" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6E6E73" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#48484A" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#151517" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1D1D20" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1D1D20" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#28282C" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#151517" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#1D1D20" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#1AFFFFFF" />
            <AcrylicBrush
                x:Key="AcrylicBackgroundFillColorDefaultBrush"
                FallbackColor="#F01D1D20"
                TintColor="#1D1D20"
                TintLuminosityOpacity="0.9"
                TintOpacity="0.7" />
        </ResourceDictionary>

        <!--
            Light: Apple Music / macOS light. White canvas, #F5F5F7 grouped surfaces, near-black #1D1D1F text,
            black-alpha hairlines and fills, frosted white glass. Status colours use Apple's accessible light variants
            so they stay readable as text on white.
        -->
        <ResourceDictionary x:Key="Light">
            <!-- App mark in the sidebar: the dark plate stands out on the light chrome. -->
            <BitmapImage x:Key="AppMarkImage" DecodePixelWidth="64" UriSource="ms-appx:///Assets/Brand/HushMarkDark.png" />
            <Color x:Key="AppBackgroundColor">#FFFFFF</Color>
            <Color x:Key="Surface1Color">#F5F5F7</Color>
            <Color x:Key="Surface2Color">#E8E8ED</Color>
            <Color x:Key="Surface3Color">#DCDCE1</Color>
            <Color x:Key="SeparatorColor">#1A000000</Color>
            <Color x:Key="HoverFillColor">#0D000000</Color>
            <Color x:Key="PressedFillColor">#14000000</Color>
            <Color x:Key="TextPrimaryColor">#1D1D1F</Color>
            <Color x:Key="TextSecondaryColor">#6E6E73</Color>
            <Color x:Key="TextTertiaryColor">#86868B</Color>
            <Color x:Key="DangerColor">#D70015</Color>
            <Color x:Key="SuccessColor">#248A3D</Color>
            <Color x:Key="WarningColor">#B25000</Color>
            <Color x:Key="ToggleOffFillColor">#E9E9EA</Color>
            <Color x:Key="ToggleKnobShadowColor">#26000000</Color>
            <Color x:Key="ToggleKnobStrokeColor">#0F000000</Color>
            <!-- Selected segment of a segmented control (raised: white on light, like macOS). -->
            <Color x:Key="SegmentSelectedFillColor">#FFFFFF</Color>
            <Color x:Key="SegmentSelectedStrokeColor">#0D000000</Color>
            <Color x:Key="SegmentSelectedShadowColor">#1F000000</Color>
            <Color x:Key="ToolTipSurfaceColor">#F5F5F7</Color>
            <Color x:Key="ToolTipTextColor">#1D1D1F</Color>
            <Color x:Key="ToolTipStrokeColor">#1F000000</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="Surface1Brush" Color="{ThemeResource Surface1Color}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{ThemeResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{ThemeResource Surface3Color}" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="{ThemeResource SeparatorColor}" />
            <SolidColorBrush x:Key="HoverFillBrush" Color="{ThemeResource HoverFillColor}" />
            <SolidColorBrush x:Key="PressedFillBrush" Color="{ThemeResource PressedFillColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
            <SolidColorBrush x:Key="ToggleOffFillBrush" Color="{ThemeResource ToggleOffFillColor}" />
            <SolidColorBrush x:Key="ToggleKnobShadowBrush" Color="{ThemeResource ToggleKnobShadowColor}" />
            <SolidColorBrush x:Key="ToggleKnobStrokeBrush" Color="{ThemeResource ToggleKnobStrokeColor}" />
            <SolidColorBrush x:Key="SegmentSelectedFillBrush" Color="{ThemeResource SegmentSelectedFillColor}" />
            <SolidColorBrush x:Key="SegmentSelectedStrokeBrush" Color="{ThemeResource SegmentSelectedStrokeColor}" />
            <SolidColorBrush x:Key="SegmentSelectedShadowBrush" Color="{ThemeResource SegmentSelectedShadowColor}" />
            <SolidColorBrush x:Key="ToolTipSurfaceBrush" Color="{ThemeResource ToolTipSurfaceColor}" />
            <SolidColorBrush x:Key="ToolTipTextBrush" Color="{ThemeResource ToolTipTextColor}" />
            <SolidColorBrush x:Key="ToolTipStrokeBrush" Color="{ThemeResource ToolTipStrokeColor}" />
            <SolidColorBrush x:Key="SliderRailBrush" Color="#21000000" />
            <SolidColorBrush x:Key="HighlightFillBrush" Color="#12000000" />
            <!-- Light hero: a white veil behind the dark name text, clearing again where the image fades out. -->
            <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00FFFFFF" />
                <GradientStop Offset="0.45" Color="#33FFFFFF" />
                <GradientStop Offset="0.8" Color="#A6FFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>

            <AcrylicBrush
                x:Key="GlassBrush"
                FallbackColor="#F2F9F9FB"
                TintColor="#F9F9FB"
                TintLuminosityOpacity="0.85"
                TintOpacity="0.6" />
            <AcrylicBrush
                x:Key="GlassStrongBrush"
                FallbackColor="#F7FBFBFD"
                TintColor="#FBFBFD"
                TintLuminosityOpacity="0.92"
                TintOpacity="0.78" />
            <!-- Modal backdrop: frosted and slightly greyed, not dimmed to black. -->
            <AcrylicBrush
                x:Key="BackdropBlurBrush"
                FallbackColor="#D9E8E8ED"
                TintColor="#E8E8ED"
                TintLuminosityOpacity="0.55"
                TintOpacity="0.45" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1D1D1F" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6E6E73" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#86868B" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#B0B0B5" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F5F5F7" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#E8E8ED" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#E8E8ED" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#DCDCE1" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#F0F0F3" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#08000000" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#1A000000" />
            <AcrylicBrush
                x:Key="AcrylicBackgroundFillColorDefaultBrush"
                FallbackColor="#F5F9F9FB"
                TintColor="#F9F9FB"
                TintLuminosityOpacity="0.9"
                TintOpacity="0.72" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- The album-art fallback before anything plays (dark theme; ThemeService/AccentColorService tune it for light). -->
    <Color x:Key="DefaultAccentColor">#9D7BFA</Color>

    <!-- Dynamic accent. Colors are replaced at runtime; these are the defaults before anything plays. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#9D7BFA" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#339D7BFA" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <!-- The accent as tuned for the dark theme, in either theme: for surfaces that stay dark (Now Playing, mini player). -->
    <SolidColorBrush x:Key="AccentOnDarkBrush" Color="#9D7BFA" />

    <!-- ===== Typography (Inter, Apple-style tight tracking on large sizes) ===== -->
    <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
    <!-- Makes every stock control (buttons, text boxes, dialogs, menus, tooltips) use Inter. Icons keep SymbolThemeFontFamily. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>

    <Style x:Key="AppTextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>

    <!-- 34 Bold: page titles -->
    <Style x:Key="LargeTitleStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-22" />
    </Style>
    <!-- 28 Bold: detail-page titles (album, artist, playlist) -->
    <Style x:Key="Title1Style" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-20" />
    </Style>
    <!-- 22 SemiBold: section titles -->
    <Style x:Key="Title2Style" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-16" />
    </Style>
    <!-- 18 SemiBold: shelf titles -->
    <Style x:Key="Title3Style" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-12" />
    </Style>
    <!-- 14 SemiBold: item titles, emphasized body -->
    <Style x:Key="HeadlineStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-6" />
    </Style>
    <!-- 14 Regular: body -->
    <Style x:Key="BodyStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="-6" />
    </Style>
    <!-- 13 Regular secondary: subtitles, artists -->
    <Style x:Key="SubheadStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="-4" />
    </Style>
    <!-- 12 Regular secondary: metadata, durations, footnotes -->
    <Style x:Key="FootnoteStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="-2" />
    </Style>
    <!-- 11 SemiBold uppercase tertiary: eyebrows above titles ("ALBUM · 2013") -->
    <Style x:Key="EyebrowStyle" BasedOn="{StaticResource AppTextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <!-- Stock ramp keys, redefined so existing XAML picks up Inter and the Apple scale. -->
    <Style x:Key="TitleLargeTextBlockStyle" BasedOn="{StaticResource LargeTitleStyle}" TargetType="TextBlock" />
    <Style x:Key="TitleTextBlockStyle" BasedOn="{StaticResource Title1Style}" TargetType="TextBlock" />
    <Style x:Key="SubtitleTextBlockStyle" BasedOn="{StaticResource Title2Style}" TargetType="TextBlock" />
    <Style x:Key="BodyStrongTextBlockStyle" BasedOn="{StaticResource HeadlineStyle}" TargetType="TextBlock" />
    <Style x:Key="BodyTextBlockStyle" BasedOn="{StaticResource BodyStyle}" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" BasedOn="{StaticResource FootnoteStyle}" TargetType="TextBlock" />

    <!-- ===== Spacing (4-pt grid) ===== -->
    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space20">20</x:Double>
    <x:Double x:Key="Space24">24</x:Double>
    <x:Double x:Key="Space32">32</x:Double>
    <x:Double x:Key="Space40">40</x:Double>
    <x:Double x:Key="Space48">48</x:Double>

    <!-- ===== Radii ===== -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="RadiusXL">20</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Rounder stock controls and overlays everywhere. -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>

    <!-- ===== Motion ===== -->
    <x:String x:Key="MotionFast">0:0:0.12</x:String>
    <x:String x:Key="MotionNormal">0:0:0.22</x:String>

    <!-- Static accent for stock controls (progress rings, focus) that can't follow the dynamic AccentBrush. -->
    <Color x:Key="SystemAccentColor">#9D7BFA</Color>
    <Color x:Key="SystemAccentColorLight1">#AE91FB</Color>
    <Color x:Key="SystemAccentColorLight2">#BFA7FC</Color>
    <Color x:Key="SystemAccentColorLight3">#D3C2FD</Color>
    <Color x:Key="SystemAccentColorDark1">#8463F0</Color>
    <Color x:Key="SystemAccentColorDark2">#6B4BD6</Color>
    <Color x:Key="SystemAccentColorDark3">#5236AE</Color>
</ResourceDictionary>
