<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Items.TrackListToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    IsTabStop="False">

    <!-- Above a track list: the filter box on the left, the sort menu on the right. -->
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The same pill as the radio search box. -->
        <Grid
            Width="280"
            Height="36"
            Background="{ThemeResource Surface2Brush}"
            ColumnSpacing="6"
            CornerRadius="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Margin="14,0,0,0"
                FontSize="13"
                Foreground="{ThemeResource TextSecondaryBrush}"
                Glyph="&#xE721;" />
            <TextBox
                x:Name="FilterBox"
                Grid.Column="1"
                Margin="0,0,4,0"
                Padding="0,7,0,7"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="TrackFilterBox"
                AutomationProperties.Name="Filter songs"
                BorderThickness="0"
                FontSize="13"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                KeyDown="OnFilterKeyDown"
                PlaceholderText="Filter songs"
                Text="{x:Bind Filter.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTipService.ToolTip="Filter by title, artist or album">
                <TextBox.Resources>
                    <ResourceDictionary>
                        <!-- Palette aliases resolve per theme only from theme dictionaries. -->
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimaryBrush" />
                                <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                                <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextTertiaryBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextTertiaryBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextTertiaryBrush" />
                                <StaticResource x:Key="TextControlButtonBackgroundPointerOver" ResourceKey="HoverFillBrush" />
                                <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="PressedFillBrush" />
                                <StaticResource x:Key="TextControlButtonForeground" ResourceKey="TextSecondaryBrush" />
                                <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                                <StaticResource x:Key="TextControlButtonForegroundPressed" ResourceKey="TextPrimaryBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimaryBrush" />
                                <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                                <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextTertiaryBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextTertiaryBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextTertiaryBrush" />
                                <StaticResource x:Key="TextControlButtonBackgroundPointerOver" ResourceKey="HoverFillBrush" />
                                <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="PressedFillBrush" />
                                <StaticResource x:Key="TextControlButtonForeground" ResourceKey="TextSecondaryBrush" />
                                <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                                <StaticResource x:Key="TextControlButtonForegroundPressed" ResourceKey="TextPrimaryBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBorderBrushPressed" Color="Transparent" />
                    </ResourceDictionary>
                </TextBox.Resources>
            </TextBox>
        </Grid>

        <!-- Own playlists: why the rows can't be dragged right now. -->
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Style="{StaticResource MetaTextStyle}"
            Text="{x:Bind Filter.ReorderHint, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />

        <Button
            x:Name="SortButton"
            Grid.Column="2"
            AutomationProperties.AutomationId="TrackSortButton"
            AutomationProperties.Name="{x:Bind Filter.SortDescription, Mode=OneWay}"
            Style="{StaticResource PillSecondaryButtonStyle}"
            ToolTipService.ToolTip="{x:Bind Filter.SortDescription, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="13" Glyph="&#xE8CB;" />
                <TextBlock Text="{x:Bind Filter.SortLabel, Mode=OneWay}" />
                <FontIcon
                    FontSize="11"
                    Glyph="{x:Bind Filter.DirectionGlyph, Mode=OneWay}"
                    Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(Filter.DirectionGlyph), Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>
            <Button.Flyout>
                <MenuFlyout
                    MenuFlyoutPresenterStyle="{StaticResource AppMenuFlyoutPresenterStyle}"
                    Opening="OnSortMenuOpening"
                    Placement="BottomEdgeAlignedRight">
                    <!-- Unstyled: an explicit MenuFlyoutItem style leaves a RadioMenuFlyoutItem without a template. -->
                    <RadioMenuFlyoutItem
                        x:Name="CustomItem"
                        AutomationProperties.AutomationId="TrackSortCustom"
                        Click="OnSortClick"
                        GroupName="TrackListSort" />
                    <RadioMenuFlyoutItem
                        x:Name="TitleItem"
                        AutomationProperties.AutomationId="TrackSortTitle"
                        Click="OnSortClick"
                        GroupName="TrackListSort"
                        Text="Title" />
                    <RadioMenuFlyoutItem
                        x:Name="ArtistItem"
                        AutomationProperties.AutomationId="TrackSortArtist"
                        Click="OnSortClick"
                        GroupName="TrackListSort"
                        Text="Artist" />
                    <RadioMenuFlyoutItem
                        x:Name="AlbumItem"
                        AutomationProperties.AutomationId="TrackSortAlbum"
                        Click="OnSortClick"
                        GroupName="TrackListSort"
                        Text="Album" />
                    <RadioMenuFlyoutItem
                        x:Name="DurationItem"
                        AutomationProperties.AutomationId="TrackSortDuration"
                        Click="OnSortClick"
                        GroupName="TrackListSort"
                        Text="Duration" />
                    <MenuFlyoutSeparator />
                    <RadioMenuFlyoutItem
                        x:Name="AscendingItem"
                        AutomationProperties.AutomationId="TrackSortAscending"
                        Click="OnDirectionClick"
                        GroupName="TrackListSortDirection" />
                    <RadioMenuFlyoutItem
                        x:Name="DescendingItem"
                        AutomationProperties.AutomationId="TrackSortDescending"
                        Click="OnDirectionClick"
                        GroupName="TrackListSortDirection" />
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
