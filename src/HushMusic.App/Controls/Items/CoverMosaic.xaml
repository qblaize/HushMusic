<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Items.CoverMosaic"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!-- Four covers in a square; with fewer than four, the first one fills it. -->
    <Grid
        x:Name="Root"
        Background="{ThemeResource Surface2Brush}"
        CornerRadius="{x:Bind CornerRadius, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            FontSize="{x:Bind PlaceholderSize, Mode=OneWay}"
            Foreground="{ThemeResource TextTertiaryBrush}"
            Glyph="&#xE8D6;" />
        <Image x:Name="Cover0" Stretch="UniformToFill" />
        <Image
            x:Name="Cover1"
            Grid.Column="1"
            Stretch="UniformToFill" />
        <Image
            x:Name="Cover2"
            Grid.Row="1"
            Stretch="UniformToFill" />
        <Image
            x:Name="Cover3"
            Grid.Row="1"
            Grid.Column="1"
            Stretch="UniformToFill" />
    </Grid>
</UserControl>
