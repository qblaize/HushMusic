<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.NowPlaying.NowPlayingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:local="using:HushMusic.App.Controls.NowPlaying"
    xmlns:radio="using:HushMusic.App.Controls.Radio"
    IsTabStop="False"
    RequestedTheme="Dark"
    Visibility="Collapsed">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/NowPlaying/NowPlayingResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Sheet over the pages (right of the rail); always dark because it sits on the album art.  -->
    <Grid
        x:Name="Root"
        AutomationProperties.AutomationId="NowPlayingView"
        AutomationProperties.Name="Now Playing"
        Background="{ThemeResource AppBackgroundBrush}">

        <!--  Album art, blurred and drifting (held still in the Minimal layout), then a frosted dark scrim for legibility.  -->
        <local:ArtworkBackdrop x:Name="Backdrop" Url="{x:Bind ViewModel.BackdropArtUrl, Mode=OneWay}" />
        <Border Background="{ThemeResource BackdropBlurBrush}" IsHitTestVisible="False" />
        <Border
            Background="{ThemeResource AppBackgroundBrush}"
            IsHitTestVisible="False"
            Opacity="0.2" />

        <!--  Close: sits in the window's title band, which lets it through (ShellPage.TitleBarInteractiveElements).  -->
        <Button
            x:Name="CloseButton"
            Width="32"
            Height="32"
            Margin="12,8,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="NowPlayingClose"
            AutomationProperties.Name="Close Now Playing"
            Command="{x:Bind ViewModel.CloseCommand}"
            Content="&#xE70D;"
            FontSize="14"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="Close (Esc)" />

        <!--  Cover Flow and the Minimal layout: hide / show the side panel. In the title band too, left of the caption buttons.  -->
        <Button
            x:Name="PanelToggleButton"
            Width="32"
            Height="32"
            Margin="0,8,150,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="NowPlayingPanelToggle"
            AutomationProperties.Name="{x:Bind ViewModel.PanelToggleLabel, Mode=OneWay}"
            Command="{x:Bind ViewModel.TogglePanelCommand}"
            Content="&#xE90D;"
            FontSize="14"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.PanelToggleLabel, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.CanTogglePanel, Mode=OneWay}" />

        <Grid
            x:Name="Layout"
            Margin="0,48,0,0"
            SizeChanged="OnLayoutSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PanelColumn" Width="400" />
            </Grid.ColumnDefinitions>

            <!--  ===== Player: artwork, title, seek, transport, volume =====  -->
            <Grid
                x:Name="PlayerArea"
                Padding="48,0,48,28"
                SizeChanged="OnPlayerAreaSizeChanged">
                <Grid
                    x:Name="PlayerStack"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Cover Flow (setting): the current cover with the songs before and after it, across the whole column.  -->
                    <local:CoverFlow
                        x:Name="Covers"
                        CloseCommand="{x:Bind ViewModel.CloseCommand}"
                        Visibility="{x:Bind ViewModel.CoverFlow.IsEnabled, Mode=OneWay}" />

                    <!--  Single artwork (setting).  -->
                    <Button
                        x:Name="ArtButton"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="NowPlayingArtwork"
                        AutomationProperties.Name="Close Now Playing"
                        Command="{x:Bind ViewModel.CloseCommand}"
                        CornerRadius="{StaticResource RadiusXL}"
                        IsTabStop="False"
                        Style="{StaticResource NowPlayingBareButtonStyle}"
                        Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.CoverFlow.IsEnabled), Mode=OneWay}">
                        <Grid
                            x:Name="ArtFrame"
                            Width="400"
                            Height="400"
                            Background="{ThemeResource Surface2Brush}"
                            CornerRadius="{StaticResource RadiusXL}"
                            Shadow="{StaticResource ShellShadow}"
                            Translation="0,0,48">
                            <FontIcon
                                FontSize="64"
                                Foreground="{ThemeResource TextTertiaryBrush}"
                                Glyph="&#xEC4F;" />
                            <local:CrossfadeImage
                                x:Name="HeroArt"
                                FallbackUrl="{x:Bind ViewModel.HeroArtFallbackUrl, Mode=OneWay}"
                                Url="{x:Bind ViewModel.HeroArtUrl, Mode=OneWay}" />
                            <!--  Live radio: the station's logo (or the song's cover when the station sends one).  -->
                            <radio:StationArt
                                LogoUrl="{x:Bind ViewModel.Player.LiveArtUrl, Mode=OneWay}"
                                StationName="{x:Bind ViewModel.Player.StationName, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Player.IsLive, Mode=OneWay}" />
                            <Border
                                BorderBrush="{ThemeResource SeparatorBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusXL}" />
                        </Grid>
                    </Button>

                    <StackPanel x:Name="ControlsPanel" Grid.Row="1">
                        <!--  Title (closes), credits (links), like, more  -->
                        <Grid Margin="0,28,0,0" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <radio:LiveBadge
                                    Margin="0,0,0,6"
                                    Accent="{StaticResource AccentOnDarkBrush}"
                                    AutomationProperties.AutomationId="NowPlayingLive"
                                    Visibility="{x:Bind ViewModel.Player.IsLive, Mode=OneWay}" />
                                <!--  Closes the view; while a station announces its song, finds that song on YouTube Music.  -->
                                <Button
                                    x:Name="TitleButton"
                                    AutomationProperties.AutomationId="NowPlayingTitle"
                                    AutomationProperties.HelpText="{x:Bind ViewModel.TitleToolTip, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.Player.Title, Mode=OneWay}"
                                    Click="OnTitleClick"
                                    Style="{StaticResource ShellTitleLinkButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.TitleToolTip, Mode=OneWay}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource NowPlayingTitleTextStyle}" Text="{x:Bind ViewModel.Player.Title, Mode=OneWay}" />
                                        <FontIcon
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Foreground="{ThemeResource TextTertiaryBrush}"
                                            Glyph="&#xE721;"
                                            Visibility="{x:Bind ViewModel.Player.CanFindOnYouTubeMusic, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                                <local:CreditsText Credits="{x:Bind ViewModel.Credits, Mode=OneWay}" TextStyle="{StaticResource NowPlayingCreditsTextStyle}" />
                            </StackPanel>
                            <ToggleButton
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="NowPlayingLike"
                                AutomationProperties.Name="Like"
                                Command="{x:Bind ViewModel.Player.ToggleLikeCommand}"
                                Content="{x:Bind ViewModel.Player.LikeGlyph, Mode=OneWay}"
                                FontSize="18"
                                IsChecked="{x:Bind ViewModel.Player.IsLiked, Mode=OneWay}"
                                Style="{StaticResource IconToggleButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Player.LikeLabel, Mode=OneWay}"
                                Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.Player.CanRate), Mode=OneWay}" />
                            <Button
                                x:Name="MoreButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="NowPlayingMore"
                                AutomationProperties.Name="More options"
                                Click="OnMoreClick"
                                Content="&#xE712;"
                                FontSize="18"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="More"
                                Visibility="{x:Bind ViewModel.IsStandard, Mode=OneWay}" />
                        </Grid>

                        <!--  Seek (live radio: a static accent hairline in its place, no times)  -->
                        <Grid
                            Height="38"
                            Margin="0,18,0,0"
                            Visibility="{x:Bind ViewModel.Player.IsLive, Mode=OneWay}">
                            <Rectangle
                                Height="3"
                                Margin="0,6,0,0"
                                VerticalAlignment="Top"
                                Fill="{StaticResource AccentOnDarkBrush}"
                                Opacity="0.35"
                                RadiusX="1.5"
                                RadiusY="1.5" />
                        </Grid>
                        <Slider
                            x:Name="SeekSlider"
                            Margin="0,18,0,0"
                            Visibility="{x:Bind ViewModel.Player.IsNotLive, Mode=OneWay}"
                            AutomationProperties.AutomationId="NowPlayingSeek"
                            AutomationProperties.Name="Seek"
                            IsEnabled="{x:Bind ViewModel.Player.CanSeek, Mode=OneWay}"
                            LargeChange="15"
                            Maximum="{x:Bind ViewModel.Player.DurationSeconds, Mode=OneWay}"
                            Minimum="0"
                            SmallChange="5"
                            StepFrequency="1"
                            ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                            Value="{x:Bind ViewModel.Player.PositionSeconds, Mode=TwoWay}" />
                        <Grid Margin="0,2,0,0" Visibility="{x:Bind ViewModel.Player.IsNotLive, Mode=OneWay}">
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource PlayerTimeTextStyle}"
                                Text="{x:Bind ViewModel.Player.PositionText, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource PlayerTimeTextStyle}"
                                Text="{x:Bind ViewModel.Player.RemainingText, Mode=OneWay}"
                                TextAlignment="Right"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Player.DurationText, Mode=OneWay}" />
                        </Grid>

                        <!--  Transport  -->
                        <StackPanel
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="20">
                            <ToggleButton
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="NowPlayingShuffle"
                                AutomationProperties.Name="Shuffle"
                                Command="{x:Bind ViewModel.Player.ToggleShuffleCommand}"
                                Content="&#xE8B1;"
                                FontSize="16"
                                IsChecked="{x:Bind ViewModel.Player.IsShuffleEnabled, Mode=OneWay}"
                                Style="{StaticResource IconToggleButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Player.ShuffleLabel, Mode=OneWay}" />
                            <Button
                                Width="48"
                                Height="48"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="NowPlayingPrevious"
                                AutomationProperties.Name="Previous"
                                Command="{x:Bind ViewModel.Player.PreviousCommand}"
                                Content="&#xF8AC;"
                                CornerRadius="24"
                                FontSize="24"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                IsEnabled="{x:Bind ViewModel.Player.HasTrack, Mode=OneWay}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Previous (Ctrl+Left)" />
                            <Button
                                x:Name="PlayPauseButton"
                                Width="64"
                                Height="64"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="NowPlayingPlayPause"
                                AutomationProperties.Name="{x:Bind ViewModel.Player.PlayPauseLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Player.PlayPauseCommand}"
                                CornerRadius="32"
                                Style="{StaticResource PlayButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Player.PlayPauseLabel, Mode=OneWay}">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="24"
                                        Text="{x:Bind ViewModel.Player.PlayPauseGlyph, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.Player.IsLoading), Mode=OneWay}" />
                                    <ProgressRing
                                        Width="26"
                                        Height="26"
                                        Foreground="{ThemeResource AppBackgroundBrush}"
                                        IsActive="{x:Bind ViewModel.Player.IsLoading, Mode=OneWay}"
                                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.Player.IsLoading), Mode=OneWay}" />
                                </Grid>
                            </Button>
                            <Button
                                Width="48"
                                Height="48"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="NowPlayingNext"
                                AutomationProperties.Name="Next"
                                Command="{x:Bind ViewModel.Player.NextCommand}"
                                Content="&#xF8AD;"
                                CornerRadius="24"
                                FontSize="24"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                IsEnabled="{x:Bind ViewModel.Player.HasTrack, Mode=OneWay}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Next (Ctrl+Right)" />
                            <ToggleButton
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="NowPlayingRepeat"
                                AutomationProperties.Name="Repeat"
                                Command="{x:Bind ViewModel.Player.CycleRepeatCommand}"
                                Content="{x:Bind ViewModel.Player.RepeatGlyph, Mode=OneWay}"
                                FontSize="16"
                                IsChecked="{x:Bind ViewModel.Player.IsRepeatActive, Mode=OneWay}"
                                Style="{StaticResource IconToggleButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Player.RepeatLabel, Mode=OneWay}" />
                        </StackPanel>

                        <!--  Volume, sleep timer, mini player (the Minimal layout keeps only the volume)  -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="NowPlayingMute"
                                AutomationProperties.Name="{x:Bind ViewModel.Player.MuteLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Player.ToggleMuteCommand}"
                                Content="{x:Bind ViewModel.Player.VolumeGlyph, Mode=OneWay}"
                                FontSize="15"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Player.MuteLabel, Mode=OneWay}" />
                            <Slider
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="NowPlayingVolume"
                                AutomationProperties.Name="Volume"
                                LargeChange="10"
                                Maximum="100"
                                Minimum="0"
                                SmallChange="2"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.Player.Volume, Mode=TwoWay}" />
                            <StackPanel
                                Grid.Column="2"
                                Margin="16,0,0,0"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.IsStandard, Mode=OneWay}">
                                <Button
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="NowPlayingSleepTimer"
                                    AutomationProperties.Name="Sleep timer"
                                    AutomationProperties.HelpText="{x:Bind ViewModel.SleepTimer.Label, Mode=OneWay}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SleepTimer.Label, Mode=OneWay}">
                                    <Grid>
                                        <FontIcon
                                            FontSize="15"
                                            Glyph="&#xE708;"
                                            Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.SleepTimer.IsActive), Mode=OneWay}" />
                                        <FontIcon
                                            FontSize="15"
                                            Foreground="{StaticResource AccentOnDarkBrush}"
                                            Glyph="&#xE708;"
                                            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.SleepTimer.IsActive), Mode=OneWay}" />
                                    </Grid>
                                    <Button.Flyout>
                                        <local:SleepTimerMenuFlyout Placement="TopEdgeAlignedRight" ViewModel="{x:Bind ViewModel.SleepTimer}" />
                                    </Button.Flyout>
                                </Button>
                                <Button
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="NowPlayingMiniPlayer"
                                    AutomationProperties.Name="Mini player"
                                    Command="{x:Bind ViewModel.EnterMiniPlayerCommand}"
                                    Content="&#xE92C;"
                                    FontSize="15"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Mini player" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  ===== Right panel: Up next | Lyrics | Related =====  -->
            <Border
                x:Name="TabsPanel"
                Grid.Column="1"
                HorizontalAlignment="Left"
                Margin="0,0,16,16"
                Background="{StaticResource NowPlayingPanelBrush}"
                BorderBrush="{ThemeResource SeparatorBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusXL}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Songs: Up next, Lyrics, Related (live radio has its own pair below).  -->
                    <Border
                        Margin="16,16,16,10"
                        Padding="2"
                        Background="{ThemeResource HoverFillBrush}"
                        CornerRadius="16"
                        Visibility="{x:Bind ViewModel.HasSongTabs, Mode=OneWay}">
                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton
                                AutomationProperties.AutomationId="NowPlayingUpNextTab"
                                AutomationProperties.Name="Up next tab"
                                Command="{x:Bind ViewModel.ShowUpNextCommand}"
                                Content="Up next"
                                IsChecked="{x:Bind ViewModel.IsUpNextTab, Mode=OneWay}"
                                Style="{StaticResource SegmentButtonStyle}" />
                            <ToggleButton
                                Grid.Column="1"
                                AutomationProperties.AutomationId="NowPlayingLyricsTab"
                                AutomationProperties.Name="Lyrics tab"
                                Command="{x:Bind ViewModel.ShowLyricsCommand}"
                                Content="Lyrics"
                                IsChecked="{x:Bind ViewModel.IsLyricsTab, Mode=OneWay}"
                                Style="{StaticResource SegmentButtonStyle}" />
                            <ToggleButton
                                Grid.Column="2"
                                AutomationProperties.AutomationId="NowPlayingRelatedTab"
                                AutomationProperties.Name="Related tab"
                                Command="{x:Bind ViewModel.ShowRelatedCommand}"
                                Content="Related"
                                IsChecked="{x:Bind ViewModel.IsRelatedTab, Mode=OneWay}"
                                Style="{StaticResource SegmentButtonStyle}" />
                        </Grid>
                    </Border>

                    <!--  Live radio: the stations, and the songs heard on this one.  -->
                    <Border
                        Margin="16,16,16,10"
                        Padding="2"
                        Background="{ThemeResource HoverFillBrush}"
                        CornerRadius="16"
                        Visibility="{x:Bind ViewModel.HasRadioTabs, Mode=OneWay}">
                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton
                                AutomationProperties.AutomationId="NowPlayingStationsTab"
                                AutomationProperties.Name="Up next tab"
                                Command="{x:Bind ViewModel.ShowUpNextCommand}"
                                Content="Up next"
                                IsChecked="{x:Bind ViewModel.IsUpNextTab, Mode=OneWay}"
                                Style="{StaticResource SegmentButtonStyle}" />
                            <ToggleButton
                                Grid.Column="1"
                                AutomationProperties.AutomationId="NowPlayingHeardTab"
                                AutomationProperties.Name="Heard on air tab"
                                Command="{x:Bind ViewModel.ShowHeardCommand}"
                                Content="Heard on air"
                                IsChecked="{x:Bind ViewModel.IsHeardTab, Mode=OneWay}"
                                Style="{StaticResource SegmentButtonStyle}" />
                        </Grid>
                    </Border>

                    <local:UpNextPanel
                        x:Name="UpNext"
                        Grid.Row="1"
                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsUpNextTab), Mode=OneWay}" />
                    <local:HeardOnAirPanel
                        x:Name="HeardPanel"
                        Grid.Row="1"
                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsHeardTab), Mode=OneWay}" />
                    <local:LyricsPanel
                        x:Name="Lyrics"
                        Grid.Row="1"
                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsLyricsTab), Mode=OneWay}" />
                    <local:RelatedPanel
                        x:Name="Related"
                        Grid.Row="1"
                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsRelatedTab), Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
