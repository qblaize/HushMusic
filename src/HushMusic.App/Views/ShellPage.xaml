<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HushMusic.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HushMusic.App.Controls"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:np="using:HushMusic.App.Controls.NowPlaying"
    xmlns:shell="using:HushMusic.App.Controls.Shell"
    xmlns:vm="using:HushMusic.App.ViewModels"
    Background="{ThemeResource WindowBackgroundBrush}"
    FontFamily="{StaticResource AppFontFamily}"
    PreviewKeyDown="OnPreviewKeyDown"
    PreviewKeyUp="OnPreviewKeyUp">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Solid window background; floating surfaces cast their shadows onto it.  -->
        <Grid
            x:Name="BackgroundLayer"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Background="{ThemeResource WindowBackgroundBrush}" />

        <!--  Ambient glow in the accent colour (see AmbientGlow); off in the Minimal player layout.  -->
        <shell:AmbientGlow
            x:Name="Glow"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            IsActive="{x:Bind ViewModel.Player.IsStandardLayout, Mode=OneWay}" />

        <!--  Draggable title band across the whole top edge (passed to Window.SetTitleBar).  -->
        <Grid
            x:Name="DragRegion"
            Grid.ColumnSpan="2"
            Height="{StaticResource TitleBarHeight}"
            Background="Transparent" />

        <shell:NavigationRail x:Name="Rail" Grid.RowSpan="2" />

        <!--  Subtle back chevron; an interactive (pass-through) hole in the title band.  -->
        <Button
            x:Name="BackButton"
            Grid.Column="1"
            Width="32"
            Height="32"
            Margin="2,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            AutomationProperties.Name="Back"
            Command="{x:Bind ViewModel.GoBackCommand}"
            Content="&#xE76B;"
            FontSize="13"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="Back (Alt+Left)" />

        <Grid
            x:Name="ContentArea"
            Grid.Row="1"
            Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Frame x:Name="ContentFrame" Margin="{StaticResource ContentFrameMargin}" />

            <!--  Standard layout: the floating glass bar, over the pages (they scroll under it).  -->
            <controls:PlayerBar
                Margin="{StaticResource PlayerBarMargin}"
                VerticalAlignment="Bottom"
                Visibility="{x:Bind ViewModel.Player.IsStandardLayout, Mode=OneWay}" />

            <!--  Minimal layout: docked in a row of its own, so the pages end above it. Created the first time it's needed.  -->
            <controls:MinimalPlayerBar
                x:Name="MinimalBar"
                Grid.Row="1"
                x:Load="False" />
        </Grid>

        <!--  Now Playing: a sheet over the pages and the player bar; the rail stays visible and usable.  -->
        <np:NowPlayingView
            x:Name="NowPlaying"
            Grid.RowSpan="2"
            Grid.Column="1" />

        <!--  Instant rail labels, positioned next to the hovered/focused rail item.  -->
        <Canvas
            x:Name="TipLayer"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            IsHitTestVisible="False">
            <Border
                x:Name="RailTip"
                Padding="10,5,10,6"
                AutomationProperties.AccessibilityView="Raw"
                Background="{ThemeResource Surface3Brush}"
                BorderBrush="{ThemeResource SeparatorBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSmall}"
                Opacity="0"
                Shadow="{StaticResource ShellShadow}"
                Translation="0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="RailTipText" Style="{StaticResource RailTipTextStyle}" />
                    <TextBlock
                        x:Name="RailTipShortcut"
                        Foreground="{ThemeResource TextTertiaryBrush}"
                        Style="{StaticResource RailTipTextStyle}" />
                </StackPanel>
            </Border>
        </Canvas>

        <!--  Errors and messages as floating toasts above the player bar and Now Playing: never silent.  -->
        <ItemsControl
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Width="{StaticResource ToastWidth}"
            Margin="0,0,24,100"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsTabStop="False"
            ItemsSource="{x:Bind ViewModel.Notifications}">
            <ItemsControl.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </ItemsControl.ItemContainerTransitions>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NotificationViewModel">
                    <Border
                        Margin="0,8,0,0"
                        Padding="14,12,6,12"
                        AutomationProperties.LiveSetting="{x:Bind LiveSetting}"
                        AutomationProperties.Name="{x:Bind Title}"
                        Background="{ThemeResource GlassStrongBrush}"
                        BorderBrush="{ThemeResource SeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLarge}"
                        Shadow="{StaticResource ShellShadow}"
                        Translation="0,0,32">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Margin="0,1,0,0"
                                VerticalAlignment="Top"
                                FontSize="16"
                                Foreground="{x:Bind shell:ShellBindings.SeverityBrush(Severity)}"
                                Glyph="{x:Bind Glyph}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource HeadlineStyle}"
                                    Text="{x:Bind Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    MaxLines="4"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource SubheadStyle}"
                                    Text="{x:Bind Message}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind helpers:Format.VisibleIf(HasMessage)}" />
                                <StackPanel
                                    Margin="0,8,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind helpers:Format.VisibleIf(HasAction)}">
                                    <Button
                                        Click="{x:Bind InvokeAction}"
                                        Content="{x:Bind ActionLabel}"
                                        Style="{StaticResource PillButtonStyle}" />
                                    <Button
                                        Click="{x:Bind InvokeSecondaryAction}"
                                        Content="{x:Bind SecondaryActionLabel}"
                                        Style="{StaticResource PillSecondaryButtonStyle}"
                                        Visibility="{x:Bind helpers:Format.VisibleIf(HasSecondaryAction)}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Dismiss"
                                Click="{x:Bind Dismiss}"
                                Content="&#xE711;"
                                FontSize="10"
                                Style="{StaticResource IconButtonStyle}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Search modal: above everything, including the rail, the title band and Now Playing.  -->
        <shell:SearchOverlay
            x:Name="SearchOverlay"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2" />
    </Grid>
</Page>
