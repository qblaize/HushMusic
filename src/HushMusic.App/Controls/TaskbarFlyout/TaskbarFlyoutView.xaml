<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.TaskbarFlyout.TaskbarFlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flyout="using:HushMusic.App.Controls.TaskbarFlyout"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:radio="using:HushMusic.App.Controls.Radio"
    FontFamily="{StaticResource AppFontFamily}"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    UseSystemFocusVisuals="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  The player bar's thin sliders: 3 px rail, accent fill, knob only on hover.  -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="SliderTrackFill" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillDisabled" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="TextPrimaryBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="TextPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="SliderTrackFill" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderTrackFillDisabled" ResourceKey="SliderRailBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="TextPrimaryBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="TextPrimaryBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
            <x:Double x:Key="SliderHorizontalHeight">16</x:Double>
            <x:Double x:Key="SliderPreContentMargin">6.5</x:Double>
            <x:Double x:Key="SliderPostContentMargin">6.5</x:Double>
            <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">11</x:Double>
            <x:Double x:Key="SliderInnerThumbHeight">11</x:Double>
            <CornerRadius x:Key="SliderTrackCornerRadius">1.5</CornerRadius>
            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush" />
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />

            <Style
                x:Key="FlyoutIconButtonStyle"
                BasedOn="{StaticResource IconButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style
                x:Key="FlyoutIconToggleStyle"
                BasedOn="{StaticResource IconToggleButtonStyle}"
                TargetType="ToggleButton">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!--  Three tiles and two Space12 gaps fit the 326 px between the flyout's padding (it is 360 wide).  -->
            <x:Double x:Key="UpNextTileSize">100</x:Double>

            <!--
                An "Up next" tile: cover on top, two lines of text below. On hover the cover brightens and a play glyph
                appears on it; pressing shrinks the tile a little. Storyboards only (implicit transitions crash here).
            -->
            <Style x:Key="UpNextTileStyle" TargetType="flyout:UpNextTileButton">
                <Setter Property="Width" Value="{StaticResource UpNextTileSize}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="flyout:UpNextTileButton">
                            <Grid
                                x:Name="RootGrid"
                                Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PressScale" />
                                </Grid.RenderTransform>
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <!--  Over the cover (the square at the top of the tile).  -->
                                <Grid
                                    x:Name="HoverLayer"
                                    Height="{TemplateBinding Width}"
                                    VerticalAlignment="Top"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                    <Border Background="{StaticResource OnArtForegroundBrush}" Opacity="0.12" />
                                    <Grid
                                        Width="26"
                                        Height="26"
                                        Margin="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="13">
                                        <FontIcon
                                            Margin="1,0,0,0"
                                            FontSize="10"
                                            Foreground="{StaticResource AccentForegroundBrush}"
                                            Glyph="&#xF5B0;" />
                                    </Grid>
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverLayer"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.12" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="PressScale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    To="1"
                                                    Duration="0:0:0.12" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="PressScale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    To="1"
                                                    Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverLayer"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.12" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="PressScale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    To="1"
                                                    Duration="0:0:0.12" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="PressScale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    To="1"
                                                    Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverLayer"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="PressScale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    To="0.97"
                                                    Duration="0:0:0.12" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="PressScale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    To="0.97"
                                                    Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Transparent: the window's desktop acrylic shows through. The hairline matches the window's 8 px corners.  -->
    <Grid
        x:Name="Root"
        Padding="16,16,16,12"
        BorderBrush="{ThemeResource SeparatorBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Cover, title, artists, like  -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid
                Width="72"
                Height="72"
                Background="{ThemeResource Surface2Brush}"
                CornerRadius="{StaticResource RadiusSmall}">
                <FontIcon
                    FontSize="24"
                    Foreground="{ThemeResource TextTertiaryBrush}"
                    Glyph="&#xEC4F;" />
                <Image
                    helpers:ImageLoader.DecodeWidth="144"
                    helpers:ImageLoader.Url="{x:Bind ViewModel.CoverUrl, Mode=OneWay}"
                    AutomationProperties.AccessibilityView="Raw"
                    Stretch="UniformToFill" />
                <Border
                    BorderBrush="{ThemeResource SeparatorBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSmall}" />
            </Grid>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    FontSize="15"
                    Style="{StaticResource HeadlineStyle}"
                    Text="{x:Bind flyout:TaskbarFlyoutBindings.TitleOf(ViewModel.Track), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind flyout:TaskbarFlyoutBindings.TitleOf(ViewModel.Track), Mode=OneWay}" />
                <TextBlock Style="{StaticResource SubheadStyle}" Text="{x:Bind flyout:TaskbarFlyoutBindings.ArtistsOf(ViewModel.Track), Mode=OneWay}" />
            </StackPanel>

            <ToggleButton
                Grid.Column="2"
                Margin="0,-6,-6,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Like"
                Command="{x:Bind ViewModel.ToggleLikeCommand}"
                Content="{x:Bind ViewModel.LikeGlyph, Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsLiked, Mode=OneWay}"
                Style="{StaticResource FlyoutIconToggleStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.LikeLabel, Mode=OneWay}"
                Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.CanRate), Mode=OneWay}" />
        </Grid>

        <!--  Seek bar with elapsed / remaining time; "LIVE" instead for streams without a duration  -->
        <Grid
            Grid.Row="1"
            Height="34"
            Margin="0,12,0,0">
            <StackPanel Visibility="{x:Bind flyout:TaskbarFlyoutBindings.SeekVisibility(ViewModel.Track, ViewModel.DurationSeconds), Mode=OneWay}">
                <Slider
                    x:Name="SeekSlider"
                    AutomationProperties.Name="Seek"
                    IsEnabled="{x:Bind ViewModel.CanSeek, Mode=OneWay}"
                    LargeChange="15"
                    Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                    Minimum="0"
                    SmallChange="5"
                    StepFrequency="1"
                    ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                    Value="{x:Bind ViewModel.PositionSeconds, Mode=TwoWay}" />
                <Grid Margin="0,2,0,0">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{StaticResource PlayerTimeTextStyle}"
                        Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource PlayerTimeTextStyle}"
                        Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}"
                        TextAlignment="Right" />
                </Grid>
            </StackPanel>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{x:Bind flyout:TaskbarFlyoutBindings.LiveVisibility(ViewModel.Track), Mode=OneWay}">
                <Ellipse
                    Width="6"
                    Height="6"
                    VerticalAlignment="Center"
                    Fill="{StaticResource AccentBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{StaticResource AccentBrush}"
                    Style="{StaticResource EyebrowStyle}"
                    Text="LIVE" />
            </StackPanel>
        </Grid>

        <!--  Shuffle, previous, play/pause, next, repeat  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="14">
            <ToggleButton
                VerticalAlignment="Center"
                AutomationProperties.Name="Shuffle"
                Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                Content="&#xE8B1;"
                IsChecked="{x:Bind ViewModel.IsShuffleEnabled, Mode=OneWay}"
                Style="{StaticResource FlyoutIconToggleStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.ShuffleLabel, Mode=OneWay}" />
            <Button
                VerticalAlignment="Center"
                AutomationProperties.Name="Previous"
                Command="{x:Bind ViewModel.PreviousCommand}"
                Content="&#xF8AC;"
                IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Previous" />
            <Button
                x:Name="PlayPauseButton"
                Width="48"
                Height="48"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.PlayPauseCommand}"
                CornerRadius="24"
                IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                Style="{StaticResource PlayButtonStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="18"
                        Text="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                        Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.IsLoading), Mode=OneWay}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        Foreground="{ThemeResource AppBackgroundBrush}"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />
                </Grid>
            </Button>
            <Button
                VerticalAlignment="Center"
                AutomationProperties.Name="Next"
                Command="{x:Bind ViewModel.NextCommand}"
                Content="&#xF8AD;"
                IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Next" />
            <ToggleButton
                VerticalAlignment="Center"
                AutomationProperties.Name="Repeat"
                Command="{x:Bind ViewModel.CycleRepeatCommand}"
                Content="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay}"
                Style="{StaticResource FlyoutIconToggleStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.RepeatLabel, Mode=OneWay}" />
        </StackPanel>

        <!--  Mute, volume, level  -->
        <Grid
            Grid.Row="3"
            Margin="0,8,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Width="32"
                Height="32"
                Margin="-6,0,0,0"
                AutomationProperties.Name="{x:Bind ViewModel.MuteLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleMuteCommand}"
                Content="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}"
                FontSize="14"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.MuteLabel, Mode=OneWay}" />
            <Slider
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Volume"
                LargeChange="10"
                Maximum="100"
                Minimum="0"
                SmallChange="5"
                StepFrequency="1"
                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="2"
                MinWidth="40"
                Style="{StaticResource PlayerTimeTextStyle}"
                Text="{x:Bind flyout:TaskbarFlyoutBindings.VolumeText(ViewModel.Volume, ViewModel.IsMuted), Mode=OneWay}"
                TextAlignment="Right" />
        </Grid>

        <!--  Up next: the next three in the queue (stations for live radio); hidden when nothing comes next.  -->
        <StackPanel
            Grid.Row="4"
            Margin="0,12,0,4"
            Visibility="{x:Bind helpers:Format.VisibleIf(UpNext.HasItems), Mode=OneWay}">
            <Border Height="1" Background="{ThemeResource SeparatorBrush}" />
            <TextBlock
                Margin="0,14,0,10"
                Style="{StaticResource EyebrowStyle}"
                Text="UP NEXT" />
            <ItemsControl
                x:Name="UpNextList"
                AutomationProperties.Name="Up next"
                IsTabStop="False"
                ItemsSource="{x:Bind UpNext.Items}"
                XYFocusKeyboardNavigation="Enabled">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="flyout:TaskbarFlyoutUpNextItem">
                        <flyout:UpNextTileButton
                            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind AccessibleName}"
                            Click="OnUpNextTileClick"
                            Command="{x:Bind PlayCommand}"
                            Style="{StaticResource UpNextTileStyle}"
                            ToolTipService.ToolTip="{x:Bind ToolTip}">
                            <StackPanel>
                                <Grid
                                    Height="{StaticResource UpNextTileSize}"
                                    Background="{ThemeResource Surface2Brush}"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                    <FontIcon
                                        FontSize="22"
                                        Foreground="{ThemeResource TextTertiaryBrush}"
                                        Glyph="&#xEC4F;" />
                                    <Image
                                        helpers:ImageLoader.DecodeWidth="100"
                                        helpers:ImageLoader.Url="{x:Bind CoverUrl}"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Stretch="UniformToFill" />
                                    <radio:StationArt
                                        LogoUrl="{x:Bind StationLogoUrl}"
                                        StationName="{x:Bind StationName}"
                                        Visibility="{x:Bind IsStation}" />
                                    <!--  Keeps light covers from melting into a light flyout.  -->
                                    <Border
                                        BorderBrush="{ThemeResource SeparatorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMedium}" />
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="13"
                                    Style="{StaticResource HeadlineStyle}"
                                    Text="{x:Bind Title}" />
                                <TextBlock
                                    Margin="0,1,0,0"
                                    Style="{StaticResource FootnoteStyle}"
                                    Text="{x:Bind Subtitle}" />
                            </StackPanel>
                        </flyout:UpNextTileButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
