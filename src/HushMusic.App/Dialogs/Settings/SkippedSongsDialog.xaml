<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="HushMusic.App.Dialogs.Settings.SkippedSongsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:viewmodels="using:HushMusic.App.ViewModels"
    Title="Songs you skip"
    CloseButtonText="Done">

    <Grid
        Width="420"
        MaxHeight="440"
        Margin="-8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="8,0,8,12"
            Style="{StaticResource SubheadStyle}"
            Text="Radio, autoplay and your weekly mix leave these out. Forgive a song to let it back in."
            TextTrimming="None"
            TextWrapping="Wrap" />

        <ListView
            Grid.Row="1"
            AutomationProperties.Name="Songs you skip"
            ItemContainerStyle="{StaticResource TrackRowContainerStyle}"
            ItemsSource="{x:Bind ViewModel.Songs}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:SkippedSongItem">
                    <Grid
                        Height="{StaticResource RowHeight}"
                        Padding="8,0"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="{StaticResource RowArtSize}"
                            Height="{StaticResource RowArtSize}"
                            VerticalAlignment="Center"
                            Background="{ThemeResource Surface2Brush}"
                            CornerRadius="{StaticResource RadiusSmall}">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextTertiaryBrush}"
                                Glyph="&#xE8D6;" />
                            <Image
                                helpers:ImageLoader.DecodeWidth="40"
                                helpers:ImageLoader.Url="{x:Bind ArtUrl}"
                                Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock Style="{StaticResource HeadlineStyle}" Text="{x:Bind Title}" />
                            <TextBlock Style="{StaticResource SubheadStyle}" Text="{x:Bind Subtitle}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind ForgiveName}"
                            Command="{x:Bind ForgiveCommand}"
                            Content="Forgive"
                            Style="{StaticResource TextActionButtonStyle}"
                            ToolTipService.ToolTip="Let radio, autoplay and your mix add it again" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="1"
            Margin="24,32"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource SubheadStyle}"
            Text="Nothing here. A song you skip in its first seconds three times shows up here."
            TextAlignment="Center"
            TextTrimming="None"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsListEmpty, Mode=OneWay}" />
    </Grid>
</ContentDialog>
