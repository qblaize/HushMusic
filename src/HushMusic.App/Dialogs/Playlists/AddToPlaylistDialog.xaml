<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="HushMusic.App.Dialogs.Playlists.AddToPlaylistDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    Title="Add to playlist"
    CloseButtonText="Cancel">

    <Grid
        Width="400"
        Height="420"
        Margin="-8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- "New playlist…" looks like the first row of the list. -->
        <Button
            AutomationProperties.Name="New playlist"
            Click="OnNewPlaylistClick"
            Style="{StaticResource RowButtonStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="{StaticResource RowArtSize}"
                    Height="{StaticResource RowArtSize}"
                    Background="{ThemeResource Surface2Brush}"
                    CornerRadius="{StaticResource RadiusSmall}">
                    <FontIcon
                        FontSize="14"
                        Foreground="{StaticResource AccentBrush}"
                        Glyph="&#xE710;" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource HeadlineStyle}"
                    Text="New playlist…" />
            </Grid>
        </Button>

        <ListView
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="OnPlaylistClick"
            ItemContainerStyle="{StaticResource TrackRowContainerStyle}"
            ItemTemplate="{StaticResource MediaRowTemplate}"
            ItemsSource="{x:Bind ViewModel.Playlists}"
            SelectionMode="None" />

        <ProgressRing
            Grid.Row="1"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Style="{StaticResource LoadingRingStyle}" />

        <TextBlock
            Grid.Row="1"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource SubheadStyle}"
            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
            TextAlignment="Center"
            TextTrimming="None"
            TextWrapping="Wrap"
            Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ViewModel.Message), Mode=OneWay}" />
    </Grid>
</ContentDialog>
