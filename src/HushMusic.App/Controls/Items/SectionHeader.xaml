<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Items.SectionHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:items="using:HushMusic.App.Controls.Items">

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Bottom" Spacing="3">
            <TextBlock
                Style="{StaticResource EyebrowStyle}"
                Text="{x:Bind items:ItemFormat.Upper(Eyebrow), Mode=OneWay}"
                Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(Eyebrow), Mode=OneWay}" />
            <TextBlock
                x:Name="TitleText"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource Title3Style}"
                Text="{x:Bind Title, Mode=OneWay}" />
        </StackPanel>

        <Button
            Grid.Column="1"
            Margin="0,0,-6,-3"
            VerticalAlignment="Bottom"
            Command="{x:Bind Command, Mode=OneWay}"
            Content="{x:Bind ActionText, Mode=OneWay}"
            Style="{StaticResource TextActionButtonStyle}"
            Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ActionText), Mode=OneWay}" />
    </Grid>
</UserControl>
