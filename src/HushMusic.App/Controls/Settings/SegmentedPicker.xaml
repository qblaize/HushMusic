<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Settings.SegmentedPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!--  Tab enters the group once; the arrow keys move between segments, Space selects.  -->
    <Border Style="{StaticResource SettingsSegmentedTrackStyle}">
        <StackPanel
            x:Name="Segments"
            Orientation="Horizontal"
            TabFocusNavigation="Once"
            XYFocusKeyboardNavigation="Enabled" />
    </Border>
</UserControl>
