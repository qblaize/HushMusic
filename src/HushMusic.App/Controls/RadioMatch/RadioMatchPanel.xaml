<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.RadioMatch.RadioMatchPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:items="using:HushMusic.App.Controls.Items"
    xmlns:vm="using:HushMusic.App.ViewModels.RadioMatch"
    AutomationProperties.AutomationId="RadioMatchPanel"
    AutomationProperties.Name="On YouTube Music">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/RadioMatch/RadioMatchResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Width="{StaticResource RadioMatchPanelWidth}">
        <!--  What the station announced  -->
        <StackPanel Margin="10,0,10,12" Spacing="2">
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource EyebrowStyle}"
                Text="{x:Bind Eyebrow}" />
            <TextBlock
                AutomationProperties.AutomationId="RadioMatchHeardTitle"
                Style="{StaticResource HeadlineStyle}"
                Text="{x:Bind ViewModel.HeardTitle, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource FootnoteStyle}"
                Text="{x:Bind ViewModel.HeardArtist, Mode=OneWay}"
                Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasHeardArtist), Mode=OneWay}" />
        </StackPanel>
        <Rectangle
            Height="1"
            Margin="10,0,10,6"
            Fill="{ThemeResource SeparatorBrush}" />

        <!--  Searching: three placeholder rows with the result geometry.  -->
        <items:Skeleton
            AutomationProperties.Name="Searching YouTube Music"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsLoading), Mode=OneWay}">
            <StackPanel>
                <Grid Padding="8,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="40" Style="{StaticResource SkeletonArtStyle}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Border
                            Width="150"
                            Height="11"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SkeletonBlockStyle}" />
                        <Border
                            Width="96"
                            Height="9"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SkeletonFaintBlockStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Padding="8,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="40" Style="{StaticResource SkeletonArtStyle}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Border
                            Width="122"
                            Height="11"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SkeletonBlockStyle}" />
                        <Border
                            Width="80"
                            Height="9"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SkeletonFaintBlockStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Padding="8,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="40" Style="{StaticResource SkeletonArtStyle}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Border
                            Width="168"
                            Height="11"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SkeletonBlockStyle}" />
                        <Border
                            Width="70"
                            Height="9"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SkeletonFaintBlockStyle}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </items:Skeleton>

        <!--  The closest songs: the row plays, the buttons on the right do the rest.  -->
        <ItemsControl
            x:Name="Results"
            AutomationProperties.AutomationId="RadioMatchResults"
            IsTabStop="False"
            ItemsSource="{x:Bind ViewModel.Matches}"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsFound), Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RadioMatchItemViewModel">
                    <Grid
                        Background="Transparent"
                        PointerCanceled="OnRowPointerExited"
                        PointerEntered="OnRowPointerEntered"
                        PointerExited="OnRowPointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="HoverFill"
                            Grid.ColumnSpan="2"
                            Background="{ThemeResource HoverFillBrush}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <Button
                            x:Name="PlayArea"
                            AutomationProperties.Name="{x:Bind Title}"
                            Command="{x:Bind PlayCommand}"
                            Style="{StaticResource RadioMatchRowButtonStyle}"
                            ToolTipService.ToolTip="Play">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="40"
                                    Height="40"
                                    Background="{ThemeResource Surface2Brush}"
                                    CornerRadius="{StaticResource RadiusSmall}">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextTertiaryBrush}"
                                        Glyph="&#xEC4F;" />
                                    <Image
                                        helpers:ImageLoader.DecodeWidth="40"
                                        helpers:ImageLoader.Url="{x:Bind ArtUrl}"
                                        Stretch="UniformToFill" />
                                    <Border
                                        BorderBrush="{ThemeResource SeparatorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSmall}" />
                                </Grid>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock Style="{StaticResource HeadlineStyle}" Text="{x:Bind Title}" />
                                    <TextBlock Style="{StaticResource FootnoteStyle}" Text="{x:Bind Subtitle}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextTertiaryBrush}"
                                    Style="{StaticResource FootnoteStyle}"
                                    Text="{x:Bind DurationText}"
                                    Typography.NumeralAlignment="Tabular" />
                            </Grid>
                        </Button>

                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="Play next"
                                Command="{x:Bind PlayNextCommand}"
                                Style="{StaticResource RadioMatchActionButtonStyle}"
                                ToolTipService.ToolTip="Play next">
                                <FontIcon Glyph="&#xE893;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Add to playlist"
                                Command="{x:Bind AddToPlaylistCommand}"
                                Style="{StaticResource RadioMatchActionButtonStyle}"
                                ToolTipService.ToolTip="Add to playlist…"
                                Visibility="{x:Bind CanRate}">
                                <FontIcon Glyph="&#xE710;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{x:Bind LikeLabel, Mode=OneWay}"
                                Command="{x:Bind ToggleLikeCommand}"
                                Style="{StaticResource RadioMatchActionButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind LikeLabel, Mode=OneWay}"
                                Visibility="{x:Bind CanRate}">
                                <Grid>
                                    <FontIcon Glyph="&#xEB51;" Visibility="{x:Bind helpers:Format.CollapsedIf(IsLiked), Mode=OneWay}" />
                                    <FontIcon
                                        Foreground="{ThemeResource AccentTextBrush}"
                                        Glyph="&#xEB52;"
                                        Visibility="{x:Bind helpers:Format.VisibleIf(IsLiked), Mode=OneWay}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Nothing close enough  -->
        <StackPanel
            Padding="16,14,16,12"
            Spacing="4"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsNoMatch), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,6"
                FontSize="22"
                Foreground="{ThemeResource TextTertiaryBrush}"
                Glyph="&#xE9CE;" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="RadioMatchNoMatch"
                Style="{StaticResource HeadlineStyle}"
                Text="No match on YouTube Music" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubheadStyle}"
                Text="It may not be on YouTube Music, or the station spells it differently."
                TextAlignment="Center"
                TextTrimming="None"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Offline or a failed request  -->
        <StackPanel
            Padding="16,14,16,12"
            Spacing="4"
            Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsFailed), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,6"
                FontSize="22"
                Foreground="{ThemeResource TextTertiaryBrush}"
                Glyph="&#xEB55;" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="RadioMatchFailed"
                Style="{StaticResource HeadlineStyle}"
                Text="Couldn't reach YouTube Music" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubheadStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextTrimming="None"
                TextWrapping="Wrap" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.RetryCommand}"
                Content="Try again"
                Style="{StaticResource PillSecondaryButtonStyle}" />
        </StackPanel>

        <Rectangle
            Height="1"
            Margin="10,6,10,0"
            Fill="{ThemeResource SeparatorBrush}" />
        <Button
            x:Name="SearchButton"
            Margin="4,4,0,0"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="RadioMatchSearch"
            Command="{x:Bind ViewModel.SearchOnYouTubeMusicCommand}"
            Style="{StaticResource TextActionButtonStyle}"
            ToolTipService.ToolTip="{x:Bind SearchToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="13" Glyph="&#xE721;" />
                <TextBlock Text="Search YouTube Music" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
