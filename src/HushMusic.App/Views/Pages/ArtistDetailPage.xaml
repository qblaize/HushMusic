<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HushMusic.App.Views.Pages.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:items="using:HushMusic.App.Controls.Items"
    xmlns:models="using:HushMusic.Core.Models">

    <Grid>
        <ScrollViewer items:Reveal.IsShown="{x:Bind ViewModel.HasContent, Mode=OneWay}">
            <StackPanel>
                <!-- Hero: the artist image edge to edge, sinking into the page, with the name and actions over it. -->
                <Grid Height="{StaticResource ArtistHeroHeight}">
                    <items:FadingArtwork
                        FadeFrom="0.5"
                        Url="{x:Bind items:ItemFormat.HeroArt(ViewModel.Artist), Mode=OneWay}"
                        VerticalAlignmentRatio="0.3" />
                    <Rectangle Fill="{ThemeResource HeroScrimBrush}" />
                    <StackPanel
                        Padding="40,0,40,28"
                        VerticalAlignment="Bottom"
                        Spacing="4">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            MaxLines="2"
                            Style="{StaticResource LargeTitleStyle}"
                            Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource SubheadStyle}"
                            Text="{x:Bind ViewModel.Stats, Mode=OneWay}"
                            Visibility="{x:Bind helpers:Format.VisibleIfNotEmpty(ViewModel.Stats), Mode=OneWay}" />
                        <StackPanel
                            Margin="0,16,0,0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Button
                                AutomationProperties.Name="Play"
                                Command="{x:Bind ViewModel.PlayCommand}"
                                Style="{StaticResource PillButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasTopSongs, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="12" Glyph="&#xF5B0;" />
                                    <TextBlock Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Shuffle"
                                Command="{x:Bind ViewModel.ShuffleCommand}"
                                Style="{StaticResource PillSecondaryButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasShuffle, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="13" Glyph="&#xE8B1;" />
                                    <TextBlock Text="Shuffle" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Radio"
                                Command="{x:Bind ViewModel.RadioCommand}"
                                Style="{StaticResource PillSecondaryButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasRadio, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="13" Glyph="&#xE93E;" />
                                    <TextBlock Text="Radio" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Padding="40,8,40,120">
                    <items:ClampedText
                        MaxWidth="720"
                        CollapsedLines="3"
                        Text="{x:Bind ViewModel.Description, Mode=OneWay}" />

                    <!-- Top songs: two columns of compact rows when the page is wide enough. -->
                    <StackPanel
                        Margin="0,36,0,0"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.HasTopSongs, Mode=OneWay}">
                        <items:SectionHeader
                            Title="Top songs"
                            ActionText="{x:Bind ViewModel.SeeAllSongsText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SeeAllSongsCommand}" />
                        <GridView
                            x:Name="TopSongsGrid"
                            Margin="-8,0"
                            Padding="0"
                            IsItemClickEnabled="True"
                            ItemClick="OnTrackClick"
                            ItemContainerStyle="{StaticResource GridTrackRowContainerStyle}"
                            ItemTemplate="{StaticResource CompactTrackRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.TopSongs}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None"
                            SizeChanged="OnTopSongsSizeChanged"
                            items:TrackDrag.IsEnabled="True"
                            items:TrackMenu.IsEnabled="True">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemHeight="{StaticResource RowHeight}" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sections}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Shelf">
                                <StackPanel Margin="0,40,0,0" Spacing="14">
                                    <items:SectionHeader Title="{x:Bind Title}" Eyebrow="{x:Bind Subtitle}" />
                                    <items:Carousel ItemClick="OnItemClick" ItemsSource="{x:Bind Items}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- First load: hero (name and buttons at its foot), top songs and a shelf. -->
        <items:Skeleton Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay}">
            <StackPanel>
                <Grid Height="{StaticResource ArtistHeroHeight}">
                    <Border
                        CornerRadius="0"
                        Opacity="0.6"
                        Style="{StaticResource SkeletonArtStyle}" />
                    <StackPanel
                        Padding="40,0,40,28"
                        VerticalAlignment="Bottom"
                        Spacing="12">
                        <Border
                            Width="280"
                            Height="32"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SkeletonBlockStyle}" />
                        <Border
                            Width="150"
                            Height="11"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SkeletonFaintBlockStyle}" />
                        <StackPanel
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Border
                                Width="92"
                                Height="36"
                                CornerRadius="18"
                                Style="{StaticResource SkeletonBlockStyle}" />
                            <Border
                                Width="112"
                                Height="36"
                                CornerRadius="18"
                                Style="{StaticResource SkeletonFaintBlockStyle}" />
                            <Border
                                Width="96"
                                Height="36"
                                CornerRadius="18"
                                Style="{StaticResource SkeletonFaintBlockStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Padding="40,44,40,0" Spacing="12">
                    <Border
                        Width="112"
                        Height="18"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SkeletonBlockStyle}" />
                    <items:SkeletonRows Margin="-8,0" Count="5" />
                    <Border
                        Width="148"
                        Height="18"
                        Margin="0,28,0,4"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SkeletonBlockStyle}" />
                    <items:SkeletonCards />
                </StackPanel>
            </StackPanel>
        </items:Skeleton>

        <ProgressBar Style="{StaticResource BusyBarStyle}" Visibility="{x:Bind ViewModel.ShowBusyBar, Mode=OneWay}" />
        <items:EmptyState
            ActionText="Try again"
            Command="{x:Bind ViewModel.RetryCommand}"
            Glyph="&#xE783;"
            Heading="Couldn't load this artist"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />
    </Grid>
</Page>
