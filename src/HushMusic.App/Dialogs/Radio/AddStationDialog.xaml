<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="HushMusic.App.Dialogs.Radio.AddStationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    Title="Add a station"
    CloseButtonText="Cancel"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Add">

    <StackPanel MinWidth="380" MaxWidth="440" Spacing="16">
        <!--  Borderless fields on Surface2, as in the playlist dialogs.  -->
        <StackPanel.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <StaticResource x:Key="TextControlBackground" ResourceKey="Surface2Brush" />
                        <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="Surface3Brush" />
                        <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Surface2Brush" />
                        <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="Surface2Brush" />
                        <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
                        <StaticResource x:Key="TextControlHeaderForeground" ResourceKey="TextSecondaryBrush" />
                        <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextTertiaryBrush" />
                        <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextTertiaryBrush" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#33FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <StaticResource x:Key="TextControlBackground" ResourceKey="Surface2Brush" />
                        <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="Surface3Brush" />
                        <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Surface2Brush" />
                        <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="Surface2Brush" />
                        <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
                        <StaticResource x:Key="TextControlHeaderForeground" ResourceKey="TextSecondaryBrush" />
                        <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextTertiaryBrush" />
                        <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextTertiaryBrush" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#29000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
            </ResourceDictionary>
        </StackPanel.Resources>

        <StackPanel Spacing="6">
            <TextBox
                x:Name="LinkBox"
                Padding="12,9"
                CornerRadius="{StaticResource RadiusMedium}"
                Header="Stream link"
                InputScope="Url"
                IsEnabled="{x:Bind helpers:Format.Not(ViewModel.IsChecking), Mode=OneWay}"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                KeyDown="OnKeyDown"
                MaxLength="2048"
                PlaceholderText="https://stream.example.com/live"
                Text="{x:Bind ViewModel.Link, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Style="{StaticResource FootnoteStyle}"
                Text="A direct stream, or a .pls or .m3u link from the station's website."
                TextWrapping="Wrap" />
        </StackPanel>
        <TextBox
            Padding="12,9"
            CornerRadius="{StaticResource RadiusMedium}"
            Header="Name"
            IsEnabled="{x:Bind helpers:Format.Not(ViewModel.IsChecking), Mode=OneWay}"
            KeyDown="OnKeyDown"
            MaxLength="100"
            PlaceholderText="Optional: the station's own name"
            Text="{x:Bind ViewModel.StationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel
            Orientation="Horizontal"
            Spacing="10"
            Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay}">
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}" />
            <TextBlock Style="{StaticResource FootnoteStyle}" Text="Checking the link…" />
        </StackPanel>
        <TextBlock
            Foreground="{ThemeResource DangerBrush}"
            Style="{StaticResource FootnoteStyle}"
            Text="{x:Bind ViewModel.Error, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
