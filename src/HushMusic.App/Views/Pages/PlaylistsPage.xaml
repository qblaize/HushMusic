<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HushMusic.App.Views.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:items="using:HushMusic.App.Controls.Items">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="40,28,40,12">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource PageTitleStyle}"
                Text="Playlists" />
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="New playlist"
                Command="{x:Bind ViewModel.CreatePlaylistCommand}"
                Style="{StaticResource PillSecondaryButtonStyle}"
                Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.RequiresSignIn), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                    <TextBlock Text="New playlist" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Playlist cards accept dropped songs (your own playlists only). -->
        <GridView
            Grid.Row="1"
            Padding="{StaticResource GridPagePadding}"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemContainerStyle="{StaticResource CardGridItemContainerStyle}"
            ItemTemplate="{StaticResource PlaylistDropCardTemplate}"
            ItemsSource="{x:Bind ViewModel.Playlists}"
            SelectionMode="None"
            items:Reveal.IsShown="{x:Bind ViewModel.HasContent, Mode=OneWay}" />

        <items:Skeleton
            Grid.Row="1"
            Padding="40,12,20,0"
            Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay}">
            <items:SkeletonCards Count="12" IsGrid="True" />
        </items:Skeleton>

        <ProgressBar
            Grid.Row="1"
            Style="{StaticResource BusyBarStyle}"
            Visibility="{x:Bind ViewModel.ShowBusyBar, Mode=OneWay}" />
        <items:EmptyState
            Grid.Row="1"
            Glyph="&#xE90B;"
            Heading="Sign in to see your playlists"
            Message="Your YouTube Music playlists appear here once you sign in."
            Visibility="{x:Bind ViewModel.RequiresSignIn, Mode=OneWay}" />
        <items:EmptyState
            Grid.Row="1"
            ActionText="New playlist"
            Command="{x:Bind ViewModel.CreatePlaylistCommand}"
            Glyph="&#xE90B;"
            Heading="No playlists yet"
            Message="Create a playlist to collect your favorite songs."
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        <items:EmptyState
            Grid.Row="1"
            ActionText="Try again"
            Command="{x:Bind ViewModel.RetryCommand}"
            Glyph="&#xE783;"
            Heading="Couldn't load your playlists"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />
    </Grid>
</Page>
