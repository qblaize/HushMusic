<?xml version="1.0" encoding="utf-8" ?>
<!--
    Hush design: no system backdrop; the shell paints a solid AppBackgroundBrush and glass is in-app acrylic.
    Windows design: Mica (set in code).
-->
<Window
    x:Class="HushMusic.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:HushMusic.App.Views"
    Title="Hush">

    <!--  The shell stays alive (collapsed) while the mini player is shown; the mini player is added on first use.  -->
    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <views:ShellPage x:Name="ShellView" />
    </Grid>
</Window>
