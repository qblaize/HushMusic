<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HushMusic.App.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:items="using:HushMusic.App.Controls.Items"
    xmlns:vm="using:HushMusic.App.ViewModels.Pages">

    <Page.Resources>
        <CollectionViewSource
            x:Name="DaysSource"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.Days}" />
    </Page.Resources>

    <Grid>
        <ListView
            Padding="{StaticResource ListPagePadding}"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemContainerStyle="{StaticResource TrackRowContainerStyle}"
            ItemTemplateSelector="{StaticResource RowTemplateSelector}"
            ItemsPanel="{StaticResource FlatGroupedItemsPanel}"
            ItemsSource="{x:Bind DaysSource.View, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind helpers:Format.CollapsedIfAny(ViewModel.RequiresSignIn, ViewModel.ShowError), Mode=OneWay}"
            items:TrackDrag.IsEnabled="True"
            items:TrackMenu.IsEnabled="True">
            <ListView.Header>
                <StackPanel>
                    <TextBlock
                        Margin="8,0,8,-12"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource PageTitleStyle}"
                        Text="History" />
                    <!-- First load: a day heading and its songs (a ListView keeps its Footer at the bottom of the window). -->
                    <items:Skeleton Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay}">
                        <StackPanel>
                            <Border
                                Width="84"
                                Height="18"
                                Margin="8,48,8,14"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SkeletonBlockStyle}" />
                            <items:SkeletonRows Count="10" />
                        </StackPanel>
                    </items:Skeleton>
                </StackPanel>
            </ListView.Header>
            <ListView.GroupStyle>
                <GroupStyle HeaderContainerStyle="{StaticResource GroupHeaderContainerStyle}">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:MediaGroup">
                            <items:SectionHeader Title="{x:Bind Title}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <ProgressBar Style="{StaticResource BusyBarStyle}" Visibility="{x:Bind ViewModel.ShowBusyBar, Mode=OneWay}" />
        <items:EmptyState
            Glyph="&#xE81C;"
            Heading="Sign in to see your history"
            Message="Songs you played on YouTube Music appear here once you sign in."
            Visibility="{x:Bind ViewModel.RequiresSignIn, Mode=OneWay}" />
        <items:EmptyState
            Glyph="&#xE81C;"
            Heading="No history yet"
            Message="Songs you play show up here."
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        <items:EmptyState
            ActionText="Try again"
            Command="{x:Bind ViewModel.RetryCommand}"
            Glyph="&#xE783;"
            Heading="Couldn't load your history"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay}" />
    </Grid>
</Page>
