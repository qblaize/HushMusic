<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HushMusic.App.Controls.Shell.SearchOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HushMusic.App.Helpers"
    xmlns:shell="using:HushMusic.App.Controls.Shell"
    xmlns:shellvm="using:HushMusic.App.ViewModels.Shell"
    Visibility="Collapsed">

    <!--  Full-window search modal: the app blurred behind a centred glass panel.  -->
    <Grid x:Name="Root" PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="18*" />
            <RowDefinition Height="82*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="Backdrop"
            Grid.RowSpan="2"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource BackdropBlurBrush}"
            Tapped="OnBackdropTapped" />

        <Grid
            x:Name="Panel"
            Grid.Row="1"
            MaxWidth="{StaticResource SearchPanelWidth}"
            Margin="24,0,24,24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            AutomationProperties.Name="Search"
            TabFocusNavigation="Cycle">
            <Border
                x:Name="PanelSurface"
                Background="{ThemeResource GlassStrongBrush}"
                BorderBrush="{ThemeResource SeparatorBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusXL}"
                Shadow="{StaticResource ShellShadow}"
                Translation="0,0,48">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Field: magnifier, large borderless text box (with its own clear button)  -->
                    <Grid
                        Height="64"
                        Padding="22,0,12,0"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="18"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Glyph="&#xE721;" />
                        <TextBox
                            x:Name="QueryBox"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="SearchQueryBox"
                            Padding="0,10,0,10"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Search"
                            BorderThickness="0"
                            FontSize="20"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            PlaceholderText="Songs, albums, artists, playlists"
                            PreviewKeyDown="OnQueryPreviewKeyDown"
                            Text="{x:Bind ViewModel.Query, Mode=OneWay}"
                            TextChanged="OnQueryTextChanged">
                            <TextBox.Resources>
                                <ResourceDictionary>
                                    <!-- Palette aliases resolve per theme only from theme dictionaries. -->
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimaryBrush" />
                                            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                                            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
                                            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextTertiaryBrush" />
                                            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextTertiaryBrush" />
                                            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextTertiaryBrush" />
                                            <StaticResource x:Key="TextControlButtonBackgroundPointerOver" ResourceKey="HoverFillBrush" />
                                            <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="PressedFillBrush" />
                                            <StaticResource x:Key="TextControlButtonForeground" ResourceKey="TextSecondaryBrush" />
                                            <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                                            <StaticResource x:Key="TextControlButtonForegroundPressed" ResourceKey="TextPrimaryBrush" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <StaticResource x:Key="TextControlForeground" ResourceKey="TextPrimaryBrush" />
                                            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                                            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextPrimaryBrush" />
                                            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextTertiaryBrush" />
                                            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="TextTertiaryBrush" />
                                            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextTertiaryBrush" />
                                            <StaticResource x:Key="TextControlButtonBackgroundPointerOver" ResourceKey="HoverFillBrush" />
                                            <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="PressedFillBrush" />
                                            <StaticResource x:Key="TextControlButtonForeground" ResourceKey="TextSecondaryBrush" />
                                            <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                                            <StaticResource x:Key="TextControlButtonForegroundPressed" ResourceKey="TextPrimaryBrush" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlButtonBorderBrushPressed" Color="Transparent" />
                                </ResourceDictionary>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>

                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{ThemeResource SeparatorBrush}"
                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasSuggestions), Mode=OneWay}" />

                    <!-- Empty field: the recent searches, with "Clear". -->
                    <Grid
                        Grid.Row="2"
                        Padding="24,14,14,0"
                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.ShowRecentHeader), Mode=OneWay}">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource EyebrowStyle}"
                            Text="RECENT SEARCHES" />
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Clear recent searches"
                            Click="OnClearRecentClick"
                            Content="Clear"
                            Style="{StaticResource TextActionButtonStyle}" />
                    </Grid>

                    <ListView
                        x:Name="Results"
                        Grid.Row="3"
                        MaxHeight="440"
                        Padding="8"
                        AutomationProperties.Name="Suggestions"
                        IsItemClickEnabled="True"
                        ItemClick="OnResultClick"
                        ItemContainerStyle="{StaticResource ShellListItemStyle}"
                        ItemsSource="{x:Bind ViewModel.Suggestions}"
                        SelectedIndex="{x:Bind ViewModel.HighlightedIndex, Mode=OneWay}"
                        SelectionMode="Single"
                        Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.HasSuggestions), Mode=OneWay}">
                        <ListView.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="HighlightFillBrush" />
                                        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="HighlightFillBrush" />
                                        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="HoverFillBrush" />
                                        <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TextPrimaryBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="HighlightFillBrush" />
                                        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="HighlightFillBrush" />
                                        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="HoverFillBrush" />
                                        <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TextPrimaryBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                                <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                            </ResourceDictionary>
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="shellvm:SearchSuggestionViewModel">
                                <Grid
                                    MinHeight="44"
                                    Padding="2,6"
                                    ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        Glyph="{x:Bind Glyph}"
                                        Visibility="{x:Bind helpers:Format.VisibleIf(HasGlyph)}" />
                                    <Grid
                                        Width="40"
                                        Height="40"
                                        Background="{ThemeResource Surface2Brush}"
                                        CornerRadius="{x:Bind shell:ShellBindings.ArtCorners(IsRound, 40)}"
                                        Visibility="{x:Bind helpers:Format.VisibleIf(HasThumbnail)}">
                                        <Image
                                            helpers:ImageLoader.DecodeWidth="40"
                                            helpers:ImageLoader.Url="{x:Bind ThumbnailUrl}"
                                            Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                        <TextBlock Style="{StaticResource BodyStyle}" Text="{x:Bind Text}" />
                                        <TextBlock
                                            Style="{StaticResource FootnoteStyle}"
                                            Text="{x:Bind Detail}"
                                            Visibility="{x:Bind helpers:Format.VisibleIf(HasDetail)}" />
                                    </StackPanel>
                                    <!-- Recent searches: remove (Delete removes the highlighted one). -->
                                    <Button
                                        Grid.Column="2"
                                        Width="28"
                                        Height="28"
                                        AutomationProperties.Name="{x:Bind RemoveLabel}"
                                        Click="OnRemoveRecentClick"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Remove"
                                        Visibility="{x:Bind helpers:Format.VisibleIf(IsRecent)}">
                                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
